#include <metal_stdlib>
using namespace metal;

struct ClusterUniforms {
    uint4 clusterOptions;
    float4 alphaOptions;
};

struct FragmentInput {
    float4 position [[position]];
    float3 worldPosition;
    float3 normal;
    float4 tangent;
    float2 uv;
};

fragment float4 main0(
    FragmentInput input [[stage_in]],
    uint primitiveId [[primitive_id]],
    texture2d<float> baseColorTexture [[texture(0)]],
    sampler baseColorSampler [[sampler(0)]],
    constant ClusterUniforms& uniforms [[buffer(0)]]) {
    const float alpha =
        baseColorTexture.sample(baseColorSampler, input.uv).a *
        uniforms.alphaOptions.z;
    if (
        (uniforms.alphaOptions.x > 0.5 &&
         uniforms.alphaOptions.x < 1.5 &&
         alpha < uniforms.alphaOptions.y) ||
        (uniforms.alphaOptions.x > 1.5 && alpha <= 0.0)) {
        discard_fragment();
    }
    const uint clusterId =
        uniforms.clusterOptions.x +
        primitiveId / max(uniforms.clusterOptions.y, 1u);
    return float4(
        float(clusterId & 0xffu) / 255.0,
        float((clusterId >> 8) & 0xffu) / 255.0,
        float((clusterId >> 16) & 0xffu) / 255.0,
        1.0);
}
