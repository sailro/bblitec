#include <metal_stdlib>
using namespace metal;

struct FragmentUniforms {
    float4 lightDirection;
    float4 lightColor;
    float4 groundColor;
    float4 cameraPosition;
    float4 cameraForwardNear;
    float4 viewRight;
    float4 viewUp;
    float4 viewForward;
    float4 baseColorFactor;
    float4 emissiveFactor;
    float4 materialFactors;
    float4 environmentFactors;
    float4 materialOptions;
    float4 normalOptions;
    float4 sphericalHarmonics[9];
};

struct FragmentInput {
    float4 position [[position]];
    float3 worldPosition;
    float3 normal;
    float4 tangent;
    float2 uv;
    float3 localPosition;
    float4 color;
};

#if defined(BBLITE_GEOMETRY_OUTPUT)
struct FragmentOutput {
    BBLITE_GEOMETRY_OUTPUT_STRUCT
};
#elif defined(BBLITE_DIAGNOSTICS_A)
struct FragmentOutput {
    float4 normal [[color(0)]];
    float4 reflectivity [[color(1)]];
    float4 irradiance [[color(2)]];
    float4 ibl [[color(3)]];
};
#elif defined(BBLITE_DIAGNOSTICS_B)
struct FragmentOutput {
    float4 depth [[color(0)]];
    float4 albedo [[color(1)]];
    float4 direct [[color(2)]];
};
#elif defined(BBLITE_DIAGNOSTICS_C)
struct FragmentOutput {
    float4 baseColor [[color(0)]];
    float4 preToneHdr [[color(1)]];
};
#endif

constant float PI = 3.14159265358979323846;

float3 evaluateIrradiance(float3 normal, constant FragmentUniforms& uniforms) {
    if (uniforms.materialFactors.w < 0.5) {
        return float3(0.0);
    }
    float3 result = uniforms.sphericalHarmonics[0].rgb;
    result += uniforms.sphericalHarmonics[1].rgb * normal.y;
    result += uniforms.sphericalHarmonics[2].rgb * normal.z;
    result += uniforms.sphericalHarmonics[3].rgb * normal.x;
    result += uniforms.sphericalHarmonics[4].rgb * normal.y * normal.x;
    result += uniforms.sphericalHarmonics[5].rgb * normal.y * normal.z;
    result += uniforms.sphericalHarmonics[6].rgb * (3.0 * normal.z * normal.z - 1.0);
    result += uniforms.sphericalHarmonics[7].rgb * normal.z * normal.x;
    result += uniforms.sphericalHarmonics[8].rgb * (normal.x * normal.x - normal.y * normal.y);
    return clamp(result, 0.0, 4.0);
}

float distributionGGX(float nDotH, float alphaG) {
    const float a2 = alphaG * alphaG;
    const float denominator = nDotH * nDotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * denominator * denominator);
}

float geometrySmithGGX(float nDotL, float nDotV, float alphaG) {
    const float a2 = alphaG * alphaG;
    const float gl = nDotL * sqrt(nDotV * (nDotV - a2 * nDotV) + a2);
    const float gv = nDotV * sqrt(nDotL * (nDotL - a2 * nDotL) + a2);
    return 0.5 / (gl + gv);
}

float3 fresnelSchlick(float cosine, float3 f0) {
    return f0 + (1.0 - f0) * pow(1.0 - cosine, 5.0);
}

#if defined(BBLITE_GEOMETRY_OUTPUT) || defined(BBLITE_DIAGNOSTICS_A) || defined(BBLITE_DIAGNOSTICS_B) || defined(BBLITE_DIAGNOSTICS_C)
fragment FragmentOutput main0(
#else
fragment float4 main0(
#endif
    FragmentInput input [[stage_in]],
    bool frontFacing [[front_facing]],
    texture2d<float> baseColorTexture [[texture(0)]],
    sampler baseColorSampler [[sampler(0)]],
    texture2d<float> metallicRoughnessTexture [[texture(1)]],
    sampler metallicRoughnessSampler [[sampler(1)]],
    texture2d<float> normalTexture [[texture(2)]],
    sampler normalSampler [[sampler(2)]],
    texture2d<float> emissiveTexture [[texture(3)]],
    sampler emissiveSampler [[sampler(3)]],
    texturecube<float> environmentTexture [[texture(4)]],
    sampler environmentSampler [[sampler(4)]],
    texture2d<float> brdfTexture [[texture(5)]],
    sampler brdfSampler [[sampler(5)]],
    constant FragmentUniforms& uniforms [[buffer(0)]]) {
    float3 geometricNormal = normalize(input.normal);
    const float3 sampledNormal =
        normalTexture.sample(normalSampler, input.uv).xyz * 2.0 - 1.0;
    float3 normal;
    if (uniforms.normalOptions.y < 0.5) {
        normal = geometricNormal;
    } else if (uniforms.normalOptions.x > 0.5) {
        const float3 positionDx = dfdx(input.worldPosition);
        const float3 positionDy = dfdy(input.worldPosition);
        const float2 uvDx = dfdx(input.uv);
        const float2 uvDy = dfdy(input.uv);
        const float3 positionDyPerpendicular = cross(positionDy, geometricNormal);
        const float3 positionDxPerpendicular = cross(geometricNormal, positionDx);
        const float3 cotangent =
            positionDyPerpendicular * uvDx.x + positionDxPerpendicular * uvDy.x;
        const float3 cobitangent =
            -(positionDyPerpendicular * uvDx.y + positionDxPerpendicular * uvDy.y);
        const float determinant =
            max(dot(cotangent, cotangent), dot(cobitangent, cobitangent));
        const float inverseMaximum = determinant > 0.0 ? rsqrt(determinant) : 0.0;
        normal = normalize(
            cotangent * inverseMaximum * sampledNormal.x +
            cobitangent * inverseMaximum * sampledNormal.y +
            geometricNormal * sampledNormal.z);
    } else {
        const float3 tangent =
            normalize(input.tangent.xyz - geometricNormal * dot(input.tangent.xyz, geometricNormal));
        const float3 bitangent = normalize(cross(geometricNormal, tangent)) * input.tangent.w;
        normal = normalize(
            tangent * sampledNormal.x +
            bitangent * sampledNormal.y +
            geometricNormal * sampledNormal.z);
    }
    if (uniforms.materialOptions.w > 0.5 && !frontFacing) {
        geometricNormal = -geometricNormal;
        normal = -normal;
    }
    const float4 baseColorSample = baseColorTexture.sample(baseColorSampler, input.uv);
    const float3 albedo =
        baseColorSample.rgb * uniforms.baseColorFactor.rgb * input.color.rgb;
    const float alpha =
        baseColorSample.a * uniforms.baseColorFactor.a * input.color.a;
    const float3 packed = metallicRoughnessTexture.sample(metallicRoughnessSampler, input.uv).rgb;
    const float occlusion = mix(1.0, packed.r, uniforms.materialFactors.z);
    const float roughness = clamp(packed.g * uniforms.materialFactors.y, 0.04, 1.0);
    const float metallic = saturate(packed.b * uniforms.materialFactors.x);
    if (
        uniforms.materialOptions.x > 0.5 &&
        uniforms.materialOptions.x < 1.5 &&
        alpha < uniforms.materialOptions.y) {
        discard_fragment();
    }
    const float3 emissive =
        emissiveTexture.sample(emissiveSampler, input.uv).rgb * uniforms.emissiveFactor.rgb;
    const float3 viewDirection = normalize(uniforms.cameraPosition.xyz - input.worldPosition);
    const float nDotVUnclamped = dot(normal, viewDirection);
    const float nDotV = abs(nDotVUnclamped) + 0.0000001;
    const float3 normalDx = dfdx(normal);
    const float3 normalDy = dfdy(normal);
    const float slopeSquare = max(dot(normalDx, normalDx), dot(normalDy, normalDy));
    const float aaRoughness = pow(saturate(slopeSquare), 0.3333333333);
    const float aaAlpha = sqrt(slopeSquare) * 0.75;
    const float alphaG = roughness * roughness + 0.0005 + aaAlpha;
    const float directRoughness = max(roughness, aaRoughness);
    const float directAlphaG = directRoughness * directRoughness + 0.0005;
    const float dielectricF0 = uniforms.normalOptions.z;
    const float3 surfaceAlbedo =
        albedo * (1.0 - dielectricF0) * (1.0 - metallic);
    float3 lightDirection;
    float nDotL;
    float lightAttenuation = 1.0;
    float diffuseWeight = 1.0;
    float3 groundSky;
    if (uniforms.lightDirection.w > 0.5) {
        const float3 lightToFragment =
            uniforms.lightDirection.xyz - input.worldPosition;
        const float lightDistanceSquared =
            dot(lightToFragment, lightToFragment);
        lightDirection = normalize(lightToFragment);
        nDotL = max(dot(normal, lightDirection), 0.0);
        lightAttenuation = max(
            0.0,
            1.0 -
                sqrt(lightDistanceSquared) /
                    max(uniforms.groundColor.w, 0.0001));
        diffuseWeight = nDotL / PI;
        groundSky = uniforms.lightColor.rgb;
    } else {
        lightDirection = normalize(uniforms.lightDirection.xyz);
        nDotL = clamp(
            dot(normal, lightDirection) * 0.5 + 0.5,
            0.0000001,
            1.0);
        groundSky =
            mix(uniforms.groundColor.rgb, uniforms.lightColor.rgb, nDotL);
    }
    const float3 halfDirection = normalize(viewDirection + lightDirection);
    const float nDotH = clamp(dot(normal, halfDirection), 0.0000001, 1.0);
    const float vDotH = saturate(dot(viewDirection, halfDirection));
    const float3 f0 = mix(float3(dielectricF0), albedo, metallic);
    const float3 fresnel = fresnelSchlick(vDotH, f0);
    const float distribution = distributionGGX(nDotH, directAlphaG);
    const float geometry = geometrySmithGGX(nDotL, nDotV, directAlphaG);
    const float3 directSpecular =
        fresnel * distribution * geometry * nDotL *
        uniforms.lightColor.rgb * uniforms.lightColor.a * lightAttenuation;
    const float3 directDiffuse =
        groundSky * surfaceAlbedo * diffuseWeight *
        uniforms.lightColor.a * lightAttenuation;
    const float3 irradiance =
        evaluateIrradiance(normal, uniforms) * uniforms.materialFactors.w;
    const float3 reflection = reflect(-viewDirection, normal);
    const float mipLevel = clamp(
        log2(max(float(environmentTexture.get_width()) * alphaG, 1.0)) *
            uniforms.environmentFactors.z,
        0.0,
        float(environmentTexture.get_num_mip_levels() - 1));
    float3 environmentRadiance =
        environmentTexture.sample(environmentSampler, reflection, level(mipLevel)).rgb *
        uniforms.materialFactors.w;
    environmentRadiance = mix(environmentRadiance, irradiance, alphaG);
    const float2 brdf =
        brdfTexture.sample(brdfSampler, float2(nDotV, roughness)).rg;
    const float3 environmentReflectance = (1.0 - f0) * brdf.x + f0 * brdf.y;
    const float specularOcclusion = saturate(
        (nDotVUnclamped + occlusion) * (nDotVUnclamped + occlusion) -
        1.0 +
        occlusion);
    const float horizon = saturate(1.0 + 1.1 * dot(reflection, geometricNormal));
    const float3 colorSpecularEnvironment =
        environmentReflectance * specularOcclusion * horizon * horizon;
    const float3 energyConservation =
        1.0 + f0 * (1.0 / max(brdf.y, 0.001) - 1.0);
    const float3 finalIrradiance = irradiance * surfaceAlbedo * occlusion;
    const float3 finalRadiance =
        environmentRadiance * colorSpecularEnvironment * energyConservation;
    const float3 finalDirectSpecular =
        directSpecular * mix(float3(1.0), energyConservation, uniforms.materialFactors.w);
    float3 color =
        finalIrradiance +
        finalRadiance +
        finalDirectSpecular +
        directDiffuse +
        emissive;
    if (uniforms.materialOptions.z > 0.5)
    {
        color = albedo;
    }
    const float3 preToneColor = color * uniforms.environmentFactors.x;
    color = preToneColor;
    if (uniforms.environmentFactors.w > 0.5) {
        color = 1.0 - exp2(-1.590579 * color);
    }
    color = pow(max(color, float3(0.0)), float3(1.0 / 2.2));
    color = saturate(color);
    const float3 highContrast = color * color * (3.0 - 2.0 * color);
    color = uniforms.environmentFactors.y < 1.0
        ? mix(float3(0.5), color, uniforms.environmentFactors.y)
        : mix(color, highContrast, uniforms.environmentFactors.y - 1.0);
#if defined(BBLITE_GEOMETRY_OUTPUT)
    FragmentOutput output;
    BBLITE_GEOMETRY_OUTPUT_WRITES
    return output;
#elif defined(BBLITE_DIAGNOSTICS_A)
    FragmentOutput output;
    output.normal = float4(normal * 0.5 + 0.5, 1.0);
    output.reflectivity = float4(f0, 1.0 - roughness);
    output.irradiance = float4(saturate(directDiffuse + finalIrradiance), 1.0);
    output.ibl = float4(saturate(finalIrradiance + finalRadiance), 1.0);
    return output;
#elif defined(BBLITE_DIAGNOSTICS_B)
    FragmentOutput output;
    const float viewDepth =
        dot(
            input.worldPosition - uniforms.cameraPosition.xyz,
            uniforms.cameraForwardNear.xyz);
    const float normalizedDepth =
        (viewDepth - uniforms.cameraForwardNear.w) /
        max(uniforms.cameraPosition.w - uniforms.cameraForwardNear.w, 0.0001);
    output.depth = float4(normalizedDepth, normalizedDepth, normalizedDepth, 1.0);
    output.albedo = float4(surfaceAlbedo, 1.0);
    output.direct = float4(saturate(directDiffuse + finalDirectSpecular), 1.0);
    return output;
#elif defined(BBLITE_DIAGNOSTICS_C)
    FragmentOutput output;
    output.baseColor = float4(albedo, alpha);
    output.preToneHdr = float4(preToneColor, 1.0);
    return output;
#else
    float finalAlpha = alpha;
    if (uniforms.materialOptions.x > 1.5) {
        const float luminanceOverAlpha =
            dot(
                finalRadiance + finalDirectSpecular,
                float3(0.2126, 0.7152, 0.0722));
        finalAlpha =
            saturate(alpha + luminanceOverAlpha * luminanceOverAlpha);
    }
    return float4(
        color,
        uniforms.materialOptions.x > 1.5 ? finalAlpha : 1.0);
#endif
}
