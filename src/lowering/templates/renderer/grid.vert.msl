#include <metal_stdlib>
using namespace metal;

struct VertexUniforms {
    float4x4 viewProjection;
};

struct VertexInput {
    float3 position [[attribute(0)]];
    float3 localPosition [[attribute(4)]];
    float3 localNormal [[attribute(7)]];
};

struct VertexOutput {
    float4 position [[position]];
    float3 localPosition;
    float3 localNormal;
};

vertex VertexOutput main0(
    VertexInput input [[stage_in]],
    constant VertexUniforms& uniforms [[buffer(0)]]) {
    VertexOutput output;
    output.position =
        uniforms.viewProjection * float4(input.position, 1.0);
    output.localPosition = input.localPosition;
    output.localNormal = input.localNormal;
    return output;
}
