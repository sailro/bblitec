#include <metal_stdlib>
using namespace metal;

struct VertexUniforms {
    float4x4 viewProjection;
};

struct VertexInput {
    float3 position [[attribute(0)]];
    float3 normal [[attribute(1)]];
    float4 tangent [[attribute(2)]];
    float2 uv [[attribute(3)]];
    float3 localPosition [[attribute(4)]];
    float2 uv2 [[attribute(5)]];
};

struct VertexOutput {
    float4 position [[position]];
    float3 worldPosition;
    float3 normal;
    float4 tangent;
    float2 uv;
    float3 localPosition;
    float2 uv2;
};

vertex VertexOutput main0(
    VertexInput input [[stage_in]],
    constant VertexUniforms& uniforms [[buffer(0)]]) {
    VertexOutput output;
    output.position = uniforms.viewProjection * float4(input.position, 1.0);
    output.worldPosition = input.position;
    output.normal = input.normal;
    output.tangent = input.tangent;
    output.uv = input.uv;
    output.localPosition = input.localPosition;
    output.uv2 = input.uv2;
    return output;
}
