#include <metal_stdlib>
using namespace metal;

struct GroundUniforms {
    float4 primaryColorAlpha;
    float4 backgroundCenter;
    float4 cameraExposure;
    float4 imageParameters;
};

struct FragmentInput {
    float4 position [[position]];
    float3 worldPosition;
    float3 normal;
    float4 tangent;
    float2 uv;
};

fragment float4 main0(
    FragmentInput input [[stage_in]],
    texture2d<float> groundTexture [[texture(0)]],
    sampler groundSampler [[sampler(0)]],
    constant GroundUniforms& uniforms [[buffer(0)]]) {
    const float4 sampleValue = groundTexture.sample(groundSampler, input.uv);
    float3 color = max(sampleValue.rgb, float3(0.0)) * uniforms.primaryColorAlpha.rgb;
    float alpha = uniforms.primaryColorAlpha.a * sampleValue.a;
    const float3 normal = normalize(input.normal);
    const float facing = dot(
        normal,
        normalize(uniforms.cameraExposure.xyz - uniforms.backgroundCenter.xyz));
    const float fade = saturate(facing / 0.1);
    alpha *= fade * fade;
    color *= uniforms.cameraExposure.w;
    if (uniforms.imageParameters.y > 0.5) {
        color = 1.0 - exp2(-1.590579 * color);
    }
    color = pow(max(color, float3(0.0)), float3(1.0 / 2.2));
    color = saturate(color);
    const float3 highContrast = color * color * (3.0 - 2.0 * color);
    color = uniforms.imageParameters.x < 1.0
        ? mix(float3(0.5), color, uniforms.imageParameters.x)
        : mix(color, highContrast, uniforms.imageParameters.x - 1.0);
    return float4(color * alpha, alpha);
}
