#include <metal_stdlib>
using namespace metal;

struct GridUniforms {
    float4 gridControl;
    float4 mainColor;
    float4 lineColor;
    float4 gridOffsetVisibility;
    float4 options;
};

struct FragmentInput {
    float4 position [[position]];
    float3 localPosition;
    float3 localNormal;
};

constant float SQRT2 = 1.41421356;
constant float PI = 3.14159;

float gridDynamicVisibility(
    float position,
    constant GridUniforms& uniforms) {
    const float frequency = uniforms.gridControl.y;
    if (
        floor(position + 0.5) ==
        floor(position / frequency + 0.5) * frequency) {
        return 1.0;
    }
    return uniforms.gridControl.z;
}

float gridAniso(float derivative) {
    return clamp(
        1.0 / (derivative + 1.0) - 1.0 / 10.0,
        0.0,
        1.0);
}

float gridIsOnLine(
    float position,
    float derivative,
    constant GridUniforms& uniforms) {
    float fraction =
        position - floor(position + 0.5);
    fraction /= derivative;
    if (uniforms.options.y > 0.5) {
        fraction = clamp(fraction, -1.0, 1.0);
        return 0.5 + 0.5 * cos(fraction * PI);
    }
    return abs(fraction) < SQRT2 / 4.0
        ? 1.0
        : 0.0;
}

float gridContrib(
    float position,
    constant GridUniforms& uniforms) {
    float derivative =
        length(float2(dfdx(position), dfdy(position)));
    derivative *= SQRT2;
    float result =
        gridIsOnLine(position, derivative, uniforms);
    result *= gridDynamicVisibility(position, uniforms);
    result *= gridAniso(derivative);
    return result;
}

float gridNormalImpact(float value) {
    return clamp(
        1.0 - 3.0 * abs(value * value * value),
        0.0,
        1.0);
}

fragment float4 main0(
    FragmentInput input [[stage_in]],
    constant GridUniforms& uniforms [[buffer(0)]]) {
    const float3 gridPosition =
        (input.localPosition +
         uniforms.gridOffsetVisibility.xyz) /
        uniforms.gridControl.x;
    float x = gridContrib(gridPosition.x, uniforms);
    float y = gridContrib(gridPosition.y, uniforms);
    float z = gridContrib(gridPosition.z, uniforms);
    const float3 normal = normalize(input.localNormal);
    x *= gridNormalImpact(normal.x);
    y *= gridNormalImpact(normal.y);
    z *= gridNormalImpact(normal.z);
    const float grid = uniforms.options.z > 0.5
        ? clamp(max(max(x, y), z), 0.0, 1.0)
        : clamp(x + y + z, 0.0, 1.0);
    float3 rgb = mix(
        uniforms.mainColor.rgb,
        uniforms.lineColor.rgb,
        float3(grid));
    float opacity = uniforms.options.x > 0.5
        ? clamp(
              grid,
              0.08,
              uniforms.gridControl.w * grid)
        : 1.0;
    if (
        uniforms.options.x > 0.5 &&
        uniforms.options.w > 0.5) {
        rgb *= opacity;
    }
    return float4(
        rgb,
        opacity * uniforms.gridOffsetVisibility.w);
}
