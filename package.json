{
  "name": "bblitec",
  "version": "0.1.0",
  "description": "Experimental Babylon Lite TypeScript-to-C++ transpiler and SDL3 native runtime.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailro/bblitec.git"
  },
  "bugs": {
    "url": "https://github.com/sailro/bblitec/issues"
  },
  "homepage": "https://github.com/sailro/bblitec#readme",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "babylon-lite",
    "cpp",
    "sdl3",
    "transpiler",
    "typescript"
  ],
  "bin": {
    "bblitec": "dist/src/cli.js"
  },
  "scripts": {
    "clean:dist": "node tools/clean-dist.mjs",
    "build": "node tools/build-if-stale.mjs",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:upstream": "npm run build && node --test \"dist/test/upstream.test.js\" \"dist/test/compiler-architecture.test.js\" \"dist/test/compiler.test.js\"",
    "scene": "npm run build && node dist/src/scene-command.js",
    "doctor": "npm run scene -- doctor",
    "dev:setup": "npm run scene -- setup",
    "sweep": "npm run scene -- validate all",
    "scenes:compile": "npm run scene -- compile all",
    "scenes:build": "npm run scene -- build all",
    "scenes:process": "npm run scene -- process all",
    "scenes:parity": "npm run scene -- parity all --differential",
    "package:demo": "pwsh -File tools/package-demo.ps1",
    "shaders:build": "pwsh -File tools/compile-shaders.ps1",
    "simplify:verify": "npm run build && node dist/src/verify-simplify.js",
    "simplify:record": "npm run build && node dist/src/verify-simplify.js --path",
    "status:verify": "npm run build && node dist/src/verify-status.js",
    "corpus:verify": "npm run build && node dist/src/verify-corpus.js",
    "lint:exports": "ts-prune -p tsconfig.json"
  },
  "devDependencies": {
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/lite": "^1.25.0",
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1",
    "@recast-navigation/wasm": "0.43.1",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.2"
  }
}
