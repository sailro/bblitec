{
  "name": "bblitec",
  "version": "0.1.0",
  "description": "Experimental Babylon Lite TypeScript-to-C++ transpiler and SDL3 native runtime.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailro/bblitec.git"
  },
  "bugs": {
    "url": "https://github.com/sailro/bblitec/issues"
  },
  "homepage": "https://github.com/sailro/bblitec#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "babylon-lite",
    "cpp",
    "sdl3",
    "transpiler",
    "typescript"
  ],
  "bin": {
    "bblitec": "dist/src/cli.js"
  },
  "scripts": {
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean:dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/compiler.test.js dist/test/parity.test.js dist/test/upstream.test.js dist/test/asset-specializer.test.js dist/test/babylon-packager.test.js dist/test/gltf-packager.test.js dist/test/scene-registry.test.js dist/test/no-any.test.js",
    "scene": "npm run build && node dist/src/scene-command.js",
    "scenes:list": "npm run scene -- list",
    "scenes:show": "npm run scene -- show",
    "scenes:compile": "npm run scene -- compile all",
    "analyze:boombox": "npm run build && node dist/src/analyze-upstream.js",
    "compile:example": "npm run scene -- compile primitives",
    "compile:boombox": "npm run scene -- compile boombox",
    "compile:scene10": "npm run scene -- compile scene10",
    "compile:scene13": "npm run scene -- compile scene13",
    "compile:scene32": "npm run scene -- compile scene32",
    "compile:scene116": "npm run scene -- compile scene116",
    "compile:scene145": "npm run scene -- compile scene145",
    "compile:scene163": "npm run scene -- compile scene163",
    "compile:scene168": "npm run scene -- compile scene168",
    "compile:scene146": "npm run scene -- compile scene146",
    "compile:scene248": "npm run scene -- compile scene248",
    "compile:scene257": "npm run scene -- compile scene257",
    "compile:scene266": "npm run scene -- compile scene266",
    "compile:scene273": "npm run scene -- compile scene273",
    "compile:scene274": "npm run scene -- compile scene274",
    "parity:reference": "npm run build && node dist/src/capture-reference.js",
    "parity:boombox": "npm run scene -- parity boombox --cpu",
    "parity:boombox:gpu": "npm run scene -- parity boombox",
    "parity:lite-diagnostics": "npm run build && node dist/src/capture-lite-diagnostics.js",
    "parity:diagnostics:compare": "npm run build && node dist/src/compare-lite-diagnostics.js",
    "parity:diagnostics": "npm run parity:lite-diagnostics && npm run parity:boombox:gpu && npm run parity:diagnostics:compare",
    "parity:scene10": "npm run scene -- parity scene10",
    "parity:scene13": "npm run scene -- parity scene13",
    "parity:scene32": "npm run scene -- parity scene32",
    "parity:scene116": "npm run scene -- parity scene116",
    "parity:scene145": "npm run scene -- parity scene145",
    "parity:scene163": "npm run scene -- parity scene163",
    "parity:scene168": "npm run scene -- parity scene168",
    "parity:scene146": "npm run scene -- parity scene146",
    "parity:scene248": "npm run scene -- parity scene248",
    "parity:scene257": "npm run scene -- parity scene257",
    "parity:scene266": "npm run scene -- parity scene266",
    "parity:scene273": "npm run scene -- parity scene273",
    "parity:scene274": "npm run scene -- parity scene274",
    "package:boombox": "pwsh -File tools/package-boombox-demo.ps1",
    "shaders:build": "pwsh -File tools/compile-shaders.ps1"
  },
  "devDependencies": {
    "@babylonjs/lite": "1.18.0",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2"
  }
}
