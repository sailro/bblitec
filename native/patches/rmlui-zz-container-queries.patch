 void Element::OnRender() {}
 
+bool Element::IsInlineSizeContainer() const
+{
+    if (meta->style.GetProperty(PropertyId::ContainerType)->Get<int>() != 1 || const_cast<Element*>(this)->IsReplaced()) return false;
+    switch (GetComputedValues().display()) {
+    case Style::Display::Block: case Style::Display::FlowRoot: case Style::Display::InlineBlock:
+    case Style::Display::Flex: case Style::Display::InlineFlex: case Style::Display::Grid: case Style::Display::InlineGrid: return true;
+    default: return false;
+    }
+}
+
+bool Element::MatchesContainerSize(float max_width, bool include_self) const
+{
+    for (auto* ancestor = include_self ? this : GetParentNode(); ancestor; ancestor = ancestor->GetParentNode()) {
+        if (ancestor->GetComputedValues().display() == Style::Display::None) return false;
+        if (!ancestor->IsInlineSizeContainer()) continue;
+        const float density = ancestor->GetContext() ? ancestor->GetContext()->GetDensityIndependentPixelRatio() : 1.f;
+        const float content_width = ancestor->main_box.GetSize().x - ancestor->GetElementScroll()->GetScrollbarSize(ElementScroll::VERTICAL);
+        return content_width <= max_width * density;
+    }
+    return false;
+}
