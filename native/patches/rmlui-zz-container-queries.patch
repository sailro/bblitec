+void StyleSheetNode::CollectContainerWidths(Vector<float>& widths) const
+{
+    for (const auto& test : selector.structural_selectors) {
+        if (test.type == StructuralSelectorType::ContainerMaxWidth) widths.push_back(test.container_max_width);
+        if (test.selector_tree) test.selector_tree->root->CollectContainerWidths(widths);
+    }
+    for (const auto& child : children) child->CollectContainerWidths(widths);
 }
 
