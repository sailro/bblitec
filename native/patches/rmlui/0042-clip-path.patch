+Geometry* ElementEffects::GetClipPath(Element* element, bool& empty)
+{
+	empty = false;
+	// Not inherited and initially none: only an authored or animating value clips.
+	if (!element->GetLocalProperty(PropertyId::ClipPath))
+		return nullptr;
+	const Property* property = element->GetProperty(PropertyId::ClipPath);
+	if (!property || property->unit != Unit::STRING)
+		return nullptr;
+	const String source = property->Get<String>();
+	auto& clip_path = element->meta->effects.clip_path;
+	if (!clip_path)
+		clip_path = MakeUnique<ClipPath>();
+	const Vector2f size = element->GetBox().GetSize(BoxArea::Border);
+	const float dp_ratio = ElementUtilities::GetDensityIndependentPixelRatio(element);
+	if (clip_path->source != source || clip_path->size != size || clip_path->dp_ratio != dp_ratio)
+	{
+		if (clip_path->source != source || clip_path->dp_ratio == 0.f)
+			clip_path->shape = ParseClipPath(source);
+		clip_path->source = source;
+		clip_path->size = size;
+		clip_path->dp_ratio = dp_ratio;
+		Mesh mesh = ClipPathMesh(clip_path->shape, size, dp_ratio);
+		clip_path->empty = !mesh;
+		RenderManager* render_manager = element->GetRenderManager();
+		clip_path->geometry = render_manager && mesh ? render_manager->MakeGeometry(std::move(mesh)) : Geometry();
+	}
+	if (clip_path->shape.kind == ClipPathShape::Kind::None)
+		return nullptr;
+	empty = clip_path->empty;
+	return &clip_path->geometry;
+}
+
+bool ElementEffects::ClipPathHits(Element* element, Vector2f point)
+{
+	for (Element* clipping = element; clipping; clipping = clipping->GetParentNode())
+	{
+		bool empty = false;
+		if (!GetClipPath(clipping, empty))
+			continue;
+		Vector2f local = point;
+		const ClipPath& clip_path = *clipping->meta->effects.clip_path;
+		if (empty || !clipping->Project(local) ||
+			!ClipPathContains(clip_path.shape, clip_path.size, clip_path.dp_ratio, local - clipping->GetAbsoluteOffset(BoxArea::Border)))
+			return false;
+	}
+	return true;
+}
+
+bool ElementEffects::PaintsIntoOpenLayer(Element* element)
+{
+	return element->meta->effects.layer_open;
+}
