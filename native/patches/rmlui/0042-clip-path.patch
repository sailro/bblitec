@@ -0,0 +1,419 @@
+#pragma once
+
+#include "../../Include/RmlUi/Core/Mesh.h"
+#include "../../Include/RmlUi/Core/Types.h"
+#include "NumberParsing.h"
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <stdexcept>
+#include <string_view>
+
+namespace Rml {
+
+// One <length-percentage> of a basic shape, linear in its reference dimension.
+struct ClipPathLength {
+	float percent = 0.f, dp = 0.f, px = 0.f;
+	float Resolve(float reference, float dp_ratio) const { return percent * 0.01f * reference + dp * dp_ratio + px; }
+};
+
+// The clip-path basic shapes (CSS Masking 1 §5, CSS Shapes 1 §3), inset() and polygon(), against the border box.
+struct ClipPathShape {
+	enum class Kind { None, Inset, Polygon };
+	Kind kind = Kind::None;
+	bool evenodd = false;
+	// inset(): top, right, bottom, left; polygon(): x and y of each vertex.
+	Vector<ClipPathLength> values;
+};
+
+namespace clip_path_detail {
+
+	[[noreturn]] inline void Fail()
+	{
+		throw std::runtime_error("UI clip-path requires none, inset() with one to four lengths or polygon() with an optional fill rule, "
+								 "over px/%/calc() lengths.");
+	}
+
+	class Parser {
+	public:
+		explicit Parser(std::string_view source) : input(source) {}
+
+		void Space()
+		{
+			while (!input.empty() && std::isspace(static_cast<unsigned char>(input.front())))
+				input.remove_prefix(1);
+		}
+		bool Take(char token)
+		{
+			Space();
+			if (input.empty() || input.front() != token)
+				return false;
+			input.remove_prefix(1);
+			return true;
+		}
+		// A case-insensitive identifier followed by a non-identifier character.
+		bool Keyword(std::string_view word)
+		{
+			Space();
+			if (input.size() < word.size())
+				return false;
+			for (size_t i = 0; i < word.size(); ++i)
+				if (std::tolower(static_cast<unsigned char>(input[i])) != word[i])
+					return false;
+			if (input.size() > word.size() && (std::isalnum(static_cast<unsigned char>(input[word.size()])) || input[word.size()] == '-'))
+				return false;
+			input.remove_prefix(word.size());
+			return true;
+		}
+		bool Done()
+		{
+			Space();
+			return input.empty();
+		}
+		char Peek()
+		{
+			Space();
+			return input.empty() ? '\0' : input.front();
+		}
+
+		// A <length-percentage>: a dimension, a unitless zero, or calc() of them.
+		ClipPathLength Length()
+		{
+			Space();
+			const Value value = Keyword("calc") ? Function() : Atom(false);
+			if (value.scalar && !(value.number == 0.f && !value.from_calc))
+				Fail();
+			return value.length;
+		}
+
+	private:
+		struct Value {
+			ClipPathLength length;
+			float number = 0.f;
+			bool scalar = false, from_calc = false;
+		};
+
+		std::string_view input;
+
+		Value Function()
+		{
+			if (input.empty() || input.front() != '(')
+				Fail();
+			input.remove_prefix(1);
+			Value value = Sum();
+			if (!Take(')'))
+				Fail();
+			value.from_calc = true;
+			return value;
+		}
+		Value Atom(bool in_calc)
+		{
+			Space();
+			if (in_calc && !input.empty() && input.front() == '(')
+				return Function();
+			if (in_calc && Keyword("calc"))
+				return Function();
+			if (!input.empty() && input.front() == '+')
+				input.remove_prefix(1);
+			float number = 0.f;
+			const auto parsed = number_parsing::from_chars(input.data(), input.data() + input.size(), number);
+			if (parsed.ec != std::errc{} || !std::isfinite(number))
+				Fail();
+			input.remove_prefix(size_t(parsed.ptr - input.data()));
+			Value value;
+			if (!input.empty() && input.front() == '%')
+			{
+				input.remove_prefix(1);
+				value.length.percent = number;
+			}
+			else if (input.size() >= 2 && (input.substr(0, 2) == "px" || input.substr(0, 2) == "dp") &&
+				(input.size() == 2 || !std::isalnum(static_cast<unsigned char>(input[2]))))
+			{
+				(input[0] == 'p' ? value.length.px : value.length.dp) = number;
+				input.remove_prefix(2);
+			}
+			else if (!input.empty() && (std::isalpha(static_cast<unsigned char>(input.front()))))
+				Fail();
+			else
+			{
+				value.scalar = true;
+				value.number = number;
+			}
+			return value;
+		}
+		static Value Scale(Value value, float factor)
+		{
+			value.length = {value.length.percent * factor, value.length.dp * factor, value.length.px * factor};
+			value.number *= factor;
+			return value;
+		}
+		Value Product()
+		{
+			Value value = Atom(true);
+			for (;;)
+			{
+				// Leave the whitespace before a + or - for Sum() to read.
+				const std::string_view before = input;
+				Space();
+				const bool multiply = !input.empty() && input.front() == '*';
+				if (!multiply && (input.empty() || input.front() != '/'))
+				{
+					input = before;
+					return value;
+				}
+				input.remove_prefix(1);
+				const Value other = Atom(true);
+				if (multiply && !value.scalar && !other.scalar)
+					Fail();
+				if (!multiply && (!other.scalar || other.number == 0.f))
+					Fail();
+				if (multiply && value.scalar && !other.scalar)
+					value = Scale(other, value.number);
+				else
+					value = Scale(value, multiply ? other.number : 1.f / other.number);
+			}
+		}
+		Value Sum()
+		{
+			Value value = Product();
+			for (;;)
+			{
+				// calc() requires whitespace on both sides of + and -.
+				if (input.size() < 3 || !std::isspace(static_cast<unsigned char>(input.front())))
+				{
+					Space();
+					return value;
+				}
+				std::string_view rest = input;
+				while (!rest.empty() && std::isspace(static_cast<unsigned char>(rest.front())))
+					rest.remove_prefix(1);
+				if (rest.size() < 2 || (rest.front() != '+' && rest.front() != '-') || !std::isspace(static_cast<unsigned char>(rest[1])))
+				{
+					Space();
+					return value;
+				}
+				const float sign = rest.front() == '-' ? -1.f : 1.f;
+				input = rest.substr(1);
+				const Value other = Scale(Product(), sign);
+				if (value.scalar != other.scalar)
+					Fail();
+				value.length = {value.length.percent + other.length.percent, value.length.dp + other.length.dp, value.length.px + other.length.px};
+				value.number += other.number;
+			}
+		}
+	};
+
+	// A fixed six-decimal form, independent of the C locale's decimal separator.
+	inline String FormatNumber(float value)
+	{
+		if (!(std::abs(value) < 1e12f))
+			Fail();
+		const long long micro = std::llround(double(value) * 1e6);
+		const unsigned long long magnitude = static_cast<unsigned long long>(micro < 0 ? -micro : micro);
+		String fraction = std::to_string(magnitude % 1000000);
+		fraction.insert(0, 6 - fraction.size(), '0');
+		return (micro < 0 ? "-" : "") + std::to_string(magnitude / 1000000) + "." + fraction;
+	}
+
+	inline String Format(const ClipPathLength& length)
+	{
+		return "calc(" + FormatNumber(length.percent) + "% + " + FormatNumber(length.dp) + "dp + " + FormatNumber(length.px) + "px)";
+	}
+
+	// The signed side of `point` against the directed edge a->b.
+	inline float Side(Vector2f a, Vector2f b, Vector2f point)
+	{
+		return (b.x - a.x) * (point.y - a.y) - (b.y - a.y) * (point.x - a.x);
+	}
+
+} // namespace clip_path_detail
+
+inline ClipPathShape ParseClipPath(std::string_view source)
+{
+	using namespace clip_path_detail;
+	Parser parser(source);
+	ClipPathShape shape;
+	if (parser.Keyword("none"))
+	{
+		if (!parser.Done())
+			Fail();
+		return shape;
+	}
+	if (parser.Keyword("inset"))
+	{
+		shape.kind = ClipPathShape::Kind::Inset;
+		if (!parser.Take('('))
+			Fail();
+		while (parser.Peek() != ')' && shape.values.size() < 4)
+			shape.values.push_back(parser.Length());
+		if (shape.values.empty() || !parser.Take(')'))
+			Fail();
+		// CSS box shorthand order: top, right = top, bottom = top, left = right.
+		if (shape.values.size() < 2)
+			shape.values.push_back(shape.values[0]);
+		if (shape.values.size() < 3)
+			shape.values.push_back(shape.values[0]);
+		if (shape.values.size() < 4)
+			shape.values.push_back(shape.values[1]);
+	}
+	else if (parser.Keyword("polygon"))
+	{
+		shape.kind = ClipPathShape::Kind::Polygon;
+		if (!parser.Take('('))
+			Fail();
+		const bool nonzero = parser.Keyword("nonzero");
+		shape.evenodd = !nonzero && parser.Keyword("evenodd");
+		if ((nonzero || shape.evenodd) && !parser.Take(','))
+			Fail();
+		do
+		{
+			shape.values.push_back(parser.Length());
+			shape.values.push_back(parser.Length());
+		} while (parser.Take(',') && shape.values.size() < 2 * 1024);
+		if (!parser.Take(')'))
+			Fail();
+	}
+	else
+		Fail();
+	if (!parser.Done())
+		Fail();
+	return shape;
+}
+
+inline String SerializeClipPath(const ClipPathShape& shape)
+{
+	using namespace clip_path_detail;
+	if (shape.kind == ClipPathShape::Kind::None)
+		return "none";
+	String result = shape.kind == ClipPathShape::Kind::Inset ? "inset(" : shape.evenodd ? "polygon(evenodd, " : "polygon(";
+	for (size_t i = 0; i < shape.values.size(); ++i)
+	{
+		if (i > 0)
+			result += (shape.kind == ClipPathShape::Kind::Polygon && i % 2 == 0) ? ", " : " ";
+		result += Format(shape.values[i]);
+	}
+	return result + ")";
+}
+
+// CSS Shapes 1 §6: shapes of one function interpolate per value, polygons only with equal vertex counts and fill rules.
+inline bool InterpolateClipPath(const ClipPathShape& from, const ClipPathShape& to, float alpha, ClipPathShape& result)
+{
+	if (from.kind == ClipPathShape::Kind::None || from.kind != to.kind || from.evenodd != to.evenodd ||
+		from.values.size() != to.values.size())
+		return false;
+	result = from;
+	for (size_t i = 0; i < from.values.size(); ++i)
+	{
+		const auto& a = from.values[i];
+		const auto& b = to.values[i];
+		result.values[i] = {a.percent + (b.percent - a.percent) * alpha, a.dp + (b.dp - a.dp) * alpha, a.px + (b.px - a.px) * alpha};
+	}
+	return true;
+}
+
+// The vertices of the shape in border-box pixels.
+inline Vector<Vector2f> ClipPathPoints(const ClipPathShape& shape, Vector2f size, float dp_ratio)
+{
+	Vector<Vector2f> points;
+	if (shape.kind == ClipPathShape::Kind::Inset)
+	{
+		const float top = shape.values[0].Resolve(size.y, dp_ratio), right = size.x - shape.values[1].Resolve(size.x, dp_ratio);
+		const float bottom = size.y - shape.values[2].Resolve(size.y, dp_ratio), left = shape.values[3].Resolve(size.x, dp_ratio);
+		// Opposing insets that meet or cross enclose no area.
+		if (left < right && top < bottom)
+			points = {{left, top}, {right, top}, {right, bottom}, {left, bottom}};
+	}
+	else if (shape.kind == ClipPathShape::Kind::Polygon)
+	{
+		for (size_t i = 0; i + 1 < shape.values.size(); i += 2)
+			points.push_back({shape.values[i].Resolve(size.x, dp_ratio), shape.values[i + 1].Resolve(size.y, dp_ratio)});
+	}
+	return points;
+}
+
+// The filled region of the shape as triangles in border-box pixels, by fill rule: the edges crossing each band
+// between consecutive vertex and intersection heights never cross inside it, so the band fills as trapezoids.
+inline Mesh ClipPathMesh(const ClipPathShape& shape, Vector2f size, float dp_ratio)
+{
+	const Vector<Vector2f> points = ClipPathPoints(shape, size, dp_ratio);
+	Mesh mesh;
+	if (points.size() < 3)
+		return mesh;
+	struct Edge {
+		Vector2f top, bottom;
+		int winding;
+		float X(float y) const { return top.x + (bottom.x - top.x) * (y - top.y) / (bottom.y - top.y); }
+	};
+	Vector<Edge> edges;
+	Vector<float> heights;
+	for (size_t i = 0; i < points.size(); ++i)
+	{
+		const Vector2f a = points[i], b = points[(i + 1) % points.size()];
+		heights.push_back(a.y);
+		if (a.y != b.y)
+			edges.push_back(a.y < b.y ? Edge{a, b, 1} : Edge{b, a, -1});
+	}
+	for (size_t i = 0; i < edges.size(); ++i)
+		for (size_t j = i + 1; j < edges.size(); ++j)
+		{
+			const Edge &p = edges[i], &q = edges[j];
+			const float denominator = (p.bottom.x - p.top.x) * (q.bottom.y - q.top.y) - (p.bottom.y - p.top.y) * (q.bottom.x - q.top.x);
+			if (denominator == 0.f)
+				continue;
+			const float t = ((q.top.x - p.top.x) * (q.bottom.y - q.top.y) - (q.top.y - p.top.y) * (q.bottom.x - q.top.x)) / denominator;
+			if (t > 0.f && t < 1.f)
+				heights.push_back(p.top.y + t * (p.bottom.y - p.top.y));
+		}
+	std::sort(heights.begin(), heights.end());
+	heights.erase(std::unique(heights.begin(), heights.end()), heights.end());
+	const ColourbPremultiplied white(255);
+	struct Crossing {
+		float top, middle, bottom;
+		int winding;
+	};
+	Vector<Crossing> crossings;
+	for (size_t band = 0; band + 1 < heights.size(); ++band)
+	{
+		const float y0 = heights[band], y1 = heights[band + 1], middle = 0.5f * (y0 + y1);
+		if (!(y1 > y0))
+			continue;
+		crossings.clear();
+		for (const Edge& edge : edges)
+			if (edge.top.y <= y0 && edge.bottom.y >= y1)
+				crossings.push_back({edge.X(y0), edge.X(middle), edge.X(y1), edge.winding});
+		std::sort(crossings.begin(), crossings.end(), [](const Crossing& a, const Crossing& b) { return a.middle < b.middle; });
+		int winding = 0;
+		for (size_t i = 0; i + 1 < crossings.size(); ++i)
+		{
+			winding += crossings[i].winding;
+			if (shape.evenodd ? (winding & 1) == 0 : winding == 0)
+				continue;
+			const Crossing &left = crossings[i], &right = crossings[i + 1];
+			const int base = int(mesh.vertices.size());
+			for (const Vector2f position : {Vector2f{left.top, y0}, Vector2f{right.top, y0}, Vector2f{right.bottom, y1}, Vector2f{left.bottom, y1}})
+				mesh.vertices.push_back(Vertex{position, white, Vector2f{}});
+			mesh.indices.insert(mesh.indices.end(), {base, base + 1, base + 2, base, base + 2, base + 3});
+		}
+	}
+	return mesh;
+}
+
+// Whether a border-box point lies inside the shape, by its fill rule.
+inline bool ClipPathContains(const ClipPathShape& shape, Vector2f size, float dp_ratio, Vector2f point)
+{
+	if (shape.kind == ClipPathShape::Kind::None)
+		return true;
+	const Vector<Vector2f> points = ClipPathPoints(shape, size, dp_ratio);
+	int winding = 0;
+	for (size_t i = 0; i < points.size(); ++i)
+	{
+		const Vector2f a = points[i], b = points[(i + 1) % points.size()];
+		if (a.y <= point.y && b.y > point.y && clip_path_detail::Side(a, b, point) > 0.f)
+			++winding;
+		else if (b.y <= point.y && a.y > point.y && clip_path_detail::Side(a, b, point) < 0.f)
+			--winding;
+	}
+	return shape.evenodd ? (winding & 1) != 0 : winding != 0;
+}
+
+} // namespace Rml
