+	/// The lengths CSS math adds to a percentage (`calc(100% - 20px)`) and the min()/max()/clamp() terms of the
+	/// same form bounding it (`min(260px, 100%)`), every length in px. The percentage resolves against its base.
+	struct LengthCalc {
+		float offset = 0;
+		bool lower = false, upper = false;
+		float lower_percent = 0, lower_offset = 0;
+		float upper_percent = 0, upper_offset = 0;
+
+		bool Any() const { return offset != 0 || lower || upper; }
+		float Resolve(float percent, float base_value) const
