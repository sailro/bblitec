+bool PropertyParserNumber::ParseLengthCalc(const String& source, float& percent, Style::LengthCalc& calc)
+{
+	const std::string_view value = source;
+	constexpr std::string_view prefix = "bbl-calc(";
+	if (value.size() <= prefix.size() || value.substr(0, prefix.size()) != prefix || value.back() != ')')
+		return false;
+	std::string_view rest = value.substr(prefix.size(), value.size() - prefix.size() - 1);
+	const auto token = [&rest]() {
+		while (!rest.empty() && StringUtilities::IsWhitespace(rest.front()))
+			rest.remove_prefix(1);
+		size_t end = 0;
+		while (end < rest.size() && !StringUtilities::IsWhitespace(rest[end]))
+			++end;
+		const std::string_view result = rest.substr(0, end);
+		rest.remove_prefix(end);
+		return result;
+	};
+	const auto number = [&token](float& out) {
+		const std::string_view text = token();
+		const auto parsed = number_parsing::from_chars(text.data(), text.data() + text.size(), out);
+		return !text.empty() && parsed.ec == std::errc() && parsed.ptr == text.data() + text.size() && std::isfinite(out);
