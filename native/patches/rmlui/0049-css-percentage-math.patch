+// Folded CSS math over a percentage: the percentage, and its lengths in px scaled like dp (CSS px).
+static Style::LengthCalc ComputeLengthCalc(const Property* property, float dp_ratio, float& percent)
+{
+	Style::LengthCalc calc;
+	if (!PropertyParserNumber::ParseLengthCalc(property->Get<String>(), percent, calc))
+	{
+		RMLUI_ERRORMSG("Invalid CSS math length");
+		percent = 0;
+		return {};
+	}
+	calc.offset *= dp_ratio;
+	calc.lower_offset *= dp_ratio;
+	calc.upper_offset *= dp_ratio;
+	return calc;
+}
