+			if (lower)
+				result = Math::Max(result, lower_percent * 0.01f * base_value + lower_offset);
+			return result;
+		}
+		bool operator==(const LengthCalc& other) const
+		{
+			return offset == other.offset && lower == other.lower && upper == other.upper && lower_percent == other.lower_percent &&
+				lower_offset == other.lower_offset && upper_percent == other.upper_percent && upper_offset == other.upper_offset;
+		}
+		bool operator!=(const LengthCalc& other) const { return !(*this == other); }
+	};
