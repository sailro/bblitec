 struct GridPlacement { GridAxisPlacement column, row; };
 struct GridBounds { int columns = 1, rows = 1, column_origin = 0, row_origin = 0; };
 
-inline GridBounds PlaceGridItems(Vector<GridPlacement>& items, int explicit_columns, int explicit_rows)
+inline GridBounds PlaceGridItems(Vector<GridPlacement>& items, int explicit_columns, int explicit_rows, bool column_flow = false)
 {
+	// CSS Grid 8.5: column flow is row flow with the axes swapped.
+	if (column_flow)
+	{
+		for (auto& item : items)
+			std::swap(item.column, item.row);
+		GridBounds bounds = PlaceGridItems(items, explicit_rows, explicit_columns);
+		for (auto& item : items)
+			std::swap(item.column, item.row);
+		std::swap(bounds.columns, bounds.rows);
+		std::swap(bounds.column_origin, bounds.row_origin);
+		return bounds;
+	}
 	// CSS Grid 8.5, sparse row flow. Definite areas reserve cells before any
 	// auto-placement, including areas appearing later in document order.
 	GridBounds bounds;
