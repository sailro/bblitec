+// Colours mix in sRGB with premultiplied alpha (CSS Color 4 ┬º12.3): a fully transparent end lends its alpha, not
+// its channels. A result past the ends, from an easing that overshoots, clamps to the representable range.
 static Colourb InterpolateColour(Colourb c0, Colourb c1, float alpha)
 {
-	Colourf c0f = ColourToLinearSpace(c0);
-	Colourf c1f = ColourToLinearSpace(c1);
-	Colourf c = Mix(c0f, c1f, alpha);
