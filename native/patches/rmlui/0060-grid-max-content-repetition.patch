+// A grid whose auto inline size, and every ancestor's up to a max-content constraint root, stretches from the
+// constraint's stand-in width: that size is indefinite (CSS Grid 7.2.3.2), so automatic repetitions count
+// from the grid's min and max widths alone.
+static bool StretchesFromMaxContentConstraint(ContainerBox* box)
+{
+	for (; box; box = box->GetParent()) {
+		if (box->GetType() == LayoutBox::Type::Root)
+			return static_cast<RootBox*>(box)->IsMaxContentConstraint();
+		if (box->GetElement() && box->GetElement()->GetComputedValues().width().type == Style::Width::Type::Length)
+			return false;
+	}
+	return false;
+}
