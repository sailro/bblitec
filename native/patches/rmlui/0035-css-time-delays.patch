+// A CSS <time>: a number with an 's' or 'ms' unit (ASCII case-insensitive), in seconds.
+static bool ParseTime(const String& argument, float& seconds)
+{
+	const char* begin = argument.data();
+	const char* const end = begin + argument.size();
+	if (begin != end && *begin == '+' && begin + 1 != end && (begin[1] == '.' || (begin[1] >= '0' && begin[1] <= '9')))
+		++begin;
+	float number = 0.0f;
+	const auto [unit, error] = number_parsing::from_chars(begin, end, number);
+	if (error != std::errc() || !std::isfinite(number))
+		return false;
+	const String suffix = StringUtilities::ToLower(String(unit, end));
+	if (suffix == "s")
+		seconds = number;
+	else if (suffix == "ms")
+		seconds = number / 1000.0f;
+	else
+		return false;
+	return true;
+}
