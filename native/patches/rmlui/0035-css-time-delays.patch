+bool PropertyParserAnimation::ParseDelays(Property& property, const StringList& delay_values)
+{
+	TransitionList delays{false, false, {}};
+	if (delay_values.size() == 1 && StringUtilities::ToLower(delay_values[0]) == "auto")
+	{
+		delays.none = true;
+	}
+	else
+	{
+		for (const String& value : delay_values)
+		{
+			Transition delay;
+			if (!ParseTime(value, delay.delay))
+				return false;
+			delays.transitions.push_back(delay);
+		}
+		if (delays.transitions.empty())
+			return false;
+	}
+
+	property.value = std::move(delays);
+	property.unit = Unit::TRANSITION;
+	return true;
+}
+
+Vector<float> PropertyParserAnimation::GetDelays(const Property* declared, const Property* resolved)
+{
+	Vector<float> delays;
+	if (!declared)
+		return delays;
+	if (!resolved || resolved->unit != Unit::TRANSITION || resolved->value.GetType() != Variant::TRANSITIONLIST)
+	{
+		delays.push_back(0.0f);
+		return delays;
+	}
+	const TransitionList& list = resolved->value.GetReference<TransitionList>();
+	if (list.none)
+		return delays;
+	for (const Transition& delay : list.transitions)
+		delays.push_back(delay.delay);
+	return delays;
+}
