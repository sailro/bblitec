+void Element::ReleaseAnimatedProperty(const ElementAnimation& animation)
+{
+	// The inline declaration a transition animated towards holds its value again.
+	if (const auto& declared = animation.GetDeclared())
+		meta->style.SetProperty(animation.GetPropertyId(), *declared);
+	else
+		RemoveProperty(animation.GetPropertyId());
+}
+
+bool Element::SetInlineProperty(const String& name, const String& value)
+{
+	PropertyDictionary properties;
+	PropertyIdSet changed;
+	if (value.empty())
+	{
+		const PropertyId id = StyleSheetSpecification::GetPropertyId(name);
+		const ShorthandId shorthand = StyleSheetSpecification::GetShorthandId(name);
+		if (id != PropertyId::Invalid)
+			changed.Insert(id);
+		else if (shorthand != ShorthandId::Invalid)
+			changed = StyleSheetSpecification::GetShorthandUnderlyingProperties(shorthand);
+		meta->style.ApplyInlineChange(changed, [&] { RemoveProperty(name); });
+		return true;
+	}
+	if (!StyleSheetSpecification::ParsePropertyDeclaration(properties, name, value))
+	{
+		Log::Message(Log::LT_WARNING, "Syntax error parsing inline property declaration '%s: %s;'.", name.c_str(), value.c_str());
+		return false;
+	}
+	for (const auto& id_property : properties.GetProperties())
+		changed.Insert(id_property.first);
+	bool result = true;
+	meta->style.ApplyInlineChange(changed, [&] { result = SetProperty(name, value); });
+	return result;
+}
