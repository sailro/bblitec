+std::optional<Transition> ElementStyle::FindTransition(const PropertySources& after, PropertyId id, const Vector<float>& delays)
+{
+	// The local property, readable before the computed values are ready.
+	const Property* transition_property = GetLocalProperty(PropertyId::Transition, after.inline_properties, after.definition);
+	if (!transition_property || transition_property->value.GetType() != Variant::TRANSITIONLIST)
+		return std::nullopt;
+	const TransitionList& transition_list = transition_property->value.GetReference<TransitionList>();
+	if (transition_list.none || transition_list.transitions.empty())
+		return std::nullopt;
+	Transition transition;
+	if (transition_list.all)
+		transition = transition_list.transitions[0];
 	else
 	{
-		for (const Transition& transition : transition_list.transitions)
+		const auto found = std::find_if(transition_list.transitions.begin(), transition_list.transitions.end(),
+			[id](const Transition& candidate) { return candidate.id == id; });
+		if (found == transition_list.transitions.end())
+			return std::nullopt;
+		transition = *found;
+	}
+	transition.id = id;
+	if (!delays.empty())
+		transition.delay = delays[size_t(transition.list_index) % delays.size()];
+	return transition;
+}
