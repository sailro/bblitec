+Vector<float> ElementStyle::TransitionDelays(const PropertySources& after)
+{
+	// A declared transition-delay list replaces the delays of the transition list, item by item.
+	const Property* declared = GetLocalProperty(PropertyId::TransitionDelay, after.inline_properties, after.definition);
+	Property delay_storage;
+	std::optional<PropertyDictionary> delay_shorthands;
+	SmallUnorderedSet<String> delay_dependencies;
+	return PropertyParserAnimation::GetDelays(declared,
+		ResolveVariablesWithShorthandExpansion(after, PropertyId::TransitionDelay, declared, delay_shorthands, delay_dependencies, delay_storage));
+}
+
+void ElementStyle::ApplyInlineChange(const PropertyIdSet& changed, const Function<void()>& apply)
+{
+	// No before-change style exists before the element first computes its values.
+	if (element->computed_values_are_default_initialized || changed.Empty())
+	{
+		apply();
+		return;
+	}
+	Vector<std::pair<PropertyId, Property>> before;
+	for (const PropertyId id : changed)
+		if (const Property* value = GetProperty(id))
+			before.emplace_back(id, *value);
+	apply();
+	const auto sources = GetPropertySources();
+	const Vector<float> delays = TransitionDelays(sources);
+	for (const auto& [id, start] : before)
+	{
+		const PropertyId property_id = id;
+		const std::optional<Transition> transition = FindTransition(sources, property_id, delays);
+		const Property* after = GetProperty(property_id);
+		if (!transition || !after)
+			continue;
+		const Property target = *after;
+		const Property* declaration = inline_properties.GetProperty(property_id);
+		std::optional<Property> declared = declaration ? std::optional<Property>(*declaration) : std::nullopt;
+		auto running = std::find_if(element->animations.begin(), element->animations.end(),
+			[property_id](const ElementAnimation& animation) { return animation.GetPropertyId() == property_id && animation.IsTransition(); });
+		// A transition runs only for a changed value and a positive combined duration (CSS Transitions 1 §3); a running
+		// transition to another value then ends, leaving the declaration.
+		if (start == target || Math::Max(transition->duration, 0.f) + transition->delay <= 0.f)
 		{
-			if (changed_properties.Contains(transition.id))
-			{
-				if (add_transition(delayed(transition)))
-					changed_properties.Erase(transition.id);
-			}
+			if (running != element->animations.end() && running->GetTarget() != target)
+				element->animations.erase(running);
+			continue;
 		}
+		if (!element->StartTransition(*transition, start, target))
+			continue;
+		running = std::find_if(element->animations.begin(), element->animations.end(),
+			[property_id](const ElementAnimation& animation) { return animation.GetPropertyId() == property_id && animation.IsTransition(); });
+		if (running != element->animations.end())
+			running->SetDeclared(std::move(declared));
 	}
 }
 
