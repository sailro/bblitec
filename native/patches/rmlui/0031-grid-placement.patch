+inline GridAxisPlacement ParseGridPlacement(std::string_view source, int explicit_tracks)
+{
+	struct Line { int number = 0; bool span = false; };
+	String lower(source);
+	std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return char(std::tolower(c)); });
