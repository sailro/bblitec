+	for (auto& item : items) if (!item.column.definite && item.row.definite) {
+		item.column.begin = locked_row_cursor[size_t(item.row.begin)];
+		while (overlaps(item)) ++item.column.begin;
+		occupy(item);
+		for (int occupied_row = item.row.begin; occupied_row < item.row.begin + item.row.span; ++occupied_row)
+			locked_row_cursor[size_t(occupied_row)] = std::max(locked_row_cursor[size_t(occupied_row)], item.column.begin + item.column.span);
+	}
+	int column = 0, row = 0;
+	for (auto& item : items) if (!item.row.definite) {
+		if (item.column.definite) {
+			if (item.column.begin < column) ++row;
+			column = item.column.begin;
+			item.row.begin = row;
+			while (overlaps(item)) item.row.begin = ++row;
+		} else {
+			for (;;) {
+				if (column + item.column.span > bounds.columns) { column = 0; ++row; }
+				item.column.begin = column; item.row.begin = row;
+				if (!overlaps(item)) break;
+				++column;
+			}
+		}
+		occupy(item);
+	}
+	return bounds;
+}
