+		check(item.column.begin + item.column.span, item.row.begin + item.row.span);
+		bounds.columns = std::max(bounds.columns, item.column.begin + item.column.span);
+		bounds.rows = std::max(bounds.rows, item.row.begin + item.row.span);
+		for (int row = item.row.begin; row < item.row.begin + item.row.span; ++row)
+			for (int column = item.column.begin; column < item.column.begin + item.column.span; ++column)
