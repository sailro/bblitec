+// The extent of the grid area spanning `span` tracks from `first`, inner gaps included.
+inline float GridAreaExtent(const Vector<float>& offsets, const Vector<GridTrack>& tracks, size_t first, size_t span)
+{
+	const size_t last = first + span - 1;
+	return offsets[last] + tracks[last].size - offsets[first];
+}
