+bool LineBox::GetEndingTextRun(ElementText*& out_text, int& out_line, float& out_available_width) const
+{
+	RMLUI_ASSERT(is_closed);
+	for (auto it = fragments.rbegin(); it != fragments.rend(); ++it)
+	{
+		// Inline boxes only open and close around the runs they hold.
+		if (it->type == FragmentType::InlineBox)
+			continue;
+		if (it->type != FragmentType::TextRun)
+			return false;
+		out_text = rmlui_static_cast<InlineLevelBox_Text*>(it->box)->GetTextElement();
+		out_line = (int)out_text->GetLines().size() - 1;
+		out_available_width = line_width - offset_horizontal_alignment - it->position.x;
+		return true;
+	}
+	return false;
+}
