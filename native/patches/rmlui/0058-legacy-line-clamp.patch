+void ElementText::EllipsizeLine(int line_index, float available_width)
+{
+	const FontFaceHandle font_face_handle = GetFontFaceHandle();
+	if (!font_face_handle || line_index < 0 || line_index >= (int)lines.size())
+		return;
+
+	const auto& computed = GetComputedValues();
+	const TextShapingContext text_shaping_context{computed.language(), computed.direction(), computed.font_kerning(), computed.letter_spacing()};
+	const char* ellipsis = (GetFontEngineInterface()->GetFontMetrics(font_face_handle).has_ellipsis ? "\xE2\x80\xA6" : "...");
+
+	// The ellipsis follows the line's content; characters before it are removed one at a time until both fit.
+	Line& line = lines[line_index];
+	String text = line.text + ellipsis;
+	StringIteratorU8 view(line.text, line.text.size());
+	while (view && view.get() != line.text.c_str() &&
+		GetFontEngineInterface()->GetStringWidth(font_face_handle, text, text_shaping_context) > available_width)
+	{
+		--view;
+		text.assign(line.text.c_str(), view.get());
+		text.append(ellipsis);
+	}
+	line.text = std::move(text);
+	geometry_dirty = true;
+}
