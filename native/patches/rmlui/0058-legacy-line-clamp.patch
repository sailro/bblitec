+// A legacy box lays out along its orient; flex-direction does not apply to it.
+Style::FlexDirection ComputedValues::flex_direction() const
+{
+	if (!legacy_box())
+		return GetLocalPropertyKeyword(PropertyId::FlexDirection, FlexDirection::Row);
+	const BoxOrient orient = GetLocalPropertyKeyword(PropertyId::WebkitBoxOrient, BoxOrient::Horizontal);
+	return orient == BoxOrient::Vertical || orient == BoxOrient::BlockAxis ? FlexDirection::Column : FlexDirection::Row;
+}
+
+int ComputedValues::line_clamp() const
+{
+	if (!legacy_box() || flex_direction() != FlexDirection::Column)
+		return 0;
+	const Property* clamp = GetLocalPropertyWithResolvedVariables(PropertyId::WebkitLineClamp);
+	return clamp && clamp->unit == Unit::NUMBER ? Math::Max(int(clamp->Get<float>()), 0) : 0;
+}
