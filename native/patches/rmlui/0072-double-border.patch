+		const Vector2f line_position = border_position + Vector2f(offsets[LEFT], offsets[TOP]);
+		const Vector2f line_size = inner_size(border_size, offsets);
+		const Vector2f corner_offsets[4] = {{offsets[LEFT], offsets[TOP]}, {offsets[RIGHT], offsets[TOP]}, {offsets[RIGHT], offsets[BOTTOM]},
+			{offsets[LEFT], offsets[BOTTOM]}};
+		CornerSizes line_radii = metrics.outer_radii;
+		for (int corner = 0; corner < 4; corner++)
