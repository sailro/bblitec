+void LineBox::HangTrailingWhiteSpace()
+{
+	for (int i = (int)fragments.size() - 1; i >= 0; i--)
+	{
+		Fragment& fragment = fragments[i];
+		if (fragment.type == FragmentType::InlineBox)
+			continue;
+		const float hanging =
+			(fragment.type == FragmentType::TextRun ? Math::Min(fragment.box->TrimTrailingWhiteSpace(fragment.fragment_handle), fragment.layout_width)
+													: 0.f);
+		if (hanging <= 0.f)
+			return;
+
+		// The run's closed ancestors end, and the empty boxes after it start, that much earlier.
+		fragment.layout_width -= hanging;
+		box_cursor -= hanging;
+		for (FragmentIndex parent = fragment.parent; parent != RootFragmentIndex; parent = fragments[parent].parent)
+			if (fragments[parent].children_end_index > 0)
+				fragments[parent].layout_width = Math::Max(fragments[parent].layout_width - hanging, 0.f);
+		for (int j = i + 1; j < (int)fragments.size(); j++)
+			fragments[j].position.x -= hanging;
+		return;
+	}
+}
