+float InlineLevelBox_Text::TrimTrailingWhiteSpace(LayoutFragmentHandle handle)
+{
+	// CSS Text 3 4.1.3: collapsible spaces ending a line are removed; preserved ones (pre-wrap) hang.
+	ElementText* text_element = GetTextElement();
+	const Style::WhiteSpace white_space = text_element->GetComputedValues().white_space();
+	const bool removed = IsCollapsible(white_space);
+	if (!removed && white_space != Style::WhiteSpace::Prewrap)
+		return 0.f;
+
+	String& contents = fragments[(size_t)handle];
+	const size_t content_end = contents.find_last_not_of(' ');
+	const size_t spaces_begin = (content_end == String::npos ? 0 : content_end + 1);
+	if (spaces_begin == contents.size())
+		return 0.f;
+
+	const Character prior = (content_end == String::npos
+			? Character::Null
+			: StringUtilities::ToCharacter(StringUtilities::SeekBackwardUTF8(contents.data() + content_end, contents.data()),
+				  contents.data() + spaces_begin));
+	const float width =
+		ElementUtilities::GetStringWidth(text_element, StringView(contents.data() + spaces_begin, contents.data() + contents.size()), prior);
+	if (removed)
+		contents.erase(spaces_begin);
+	return width;
 }
 
