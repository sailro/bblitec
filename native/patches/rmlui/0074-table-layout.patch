+// A cell's outer min-content and max-content widths (CSS Tables 3 'computing cell measures'), resolved as Chromium's
+// TableTypes::CreateCellInlineConstraint does. All widths are border-box widths.
+struct CellWidths {
+	float min = 0.f;
+	float max = 0.f;
+	float percent = 0.f; // A percentage width, 0 for none.
+	bool constrained = false;
+
+	// TableTypes::CellInlineConstraint::Encompass.
+	void Encompass(const CellWidths& other)
+	{
+		min = Math::Max(min, other.min);
+		if (constrained == other.constrained)
+			max = Math::Max(max, other.max);
+		else if (constrained)
+			max = Math::Max(max, other.min);
+		else
+			max = Math::Max(min, other.max);
+		constrained = constrained || other.constrained;
+		percent = Math::Max(percent, other.percent);
+	}
+};
+
+// A column's widths in an automatic table layout (TableTypes::Column).
+struct ColumnWidths {
+	float min = 0.f;
+	float max = 0.f;
+	float percent = 0.f;
+	bool constrained = false;
+	bool merged = true;
+	bool sized = false;
+
+	// TableTypes::Column::Encompass for an automatic layout.
+	void Encompass(const CellWidths& cell)
+	{
+		merged = false;
+		if (sized)
+		{
+			min = Math::Max(min, cell.min);
+			max = Math::Max(max, constrained && !cell.constrained ? cell.min : cell.max);
+		}
+		else
+		{
+			min = cell.min;
+			max = cell.max;
+			sized = true;
+		}
+		max = Math::Max(min, max);
+		percent = Math::Max(percent, cell.percent);
+		constrained = constrained || cell.constrained;
+	}
+
+	float ResolvePercent(float target) const { return Math::Max(min, percent * target / 100.f); }
+};
+
+CellWidths MeasureCell(Element* cell, Vector2f containing_block)
+{
+	Box box;
+	LayoutDetails::BuildBox(box, containing_block, cell, BuildBoxMode::UnalignedBlock);
+	const float edges = box.GetSizeAcross(BoxDirection::Horizontal, BoxArea::Border, BoxArea::Padding);
+	const ComputedValues& computed = cell->GetComputedValues();
+	const float to_border_box = computed.box_sizing() == Style::BoxSizing::ContentBox ? edges : 0.f;
+
+	CellWidths result;
+	const Style::Width width = computed.width();
+	const bool css_width = width.type == Style::Width::Length;
+	if (width.type == Style::Width::Percentage)
+		result.percent = width.value;
+	const Style::MinWidth min_width = computed.min_width();
+	const Style::MaxWidth max_width = computed.max_width();
+	const bool css_max = max_width.type == Style::MaxWidth::Length && max_width.value < FLT_MAX;
+
+	float min = LayoutDetails::GetMinContentWidth(cell, box, box.GetSize().y, containing_block) + edges;
+	if (min_width.type == Style::MinWidth::Length)
+		min = Math::Max(min, min_width.value + to_border_box);
+	float content_max = css_width ? width.value + to_border_box : LayoutDetails::GetShrinkToFitWidth(cell, containing_block, true) + edges;
+	if (css_max)
+	{
+		content_max = Math::Min(content_max, max_width.value + to_border_box);
+		min = Math::Min(min, max_width.value + to_border_box);
+	}
+	result.min = min;
+	result.max = Math::Max(min, content_max);
+	result.constrained = css_width;
+	return result;
+}
+
+// Distributes a target width over columns (CSS Tables 3 'width distribution algorithm'), as Chromium's
+// DistributeInlineSizeToComputedInlineSizeAuto does. Merged columns take no width.
+Vector<float> DistributeWidth(float target, const ColumnWidths* columns, const int count, const bool constrained_target)
+{
+	enum { MinGuess, PercentageGuess, SpecifiedGuess, MaxGuess, AboveMax };
+	float guess[AboveMax] = {};
+	float increase[AboveMax] = {};
+	float total_percent = 0.f, total_auto_max = 0.f, total_fixed_max = 0.f;
+	int percent_count = 0, fixed_count = 0, auto_count = 0;
+	for (int i = 0; i < count; i++)
+	{
+		const ColumnWidths& column = columns[i];
+		if (column.merged)
+			continue;
+		if (column.percent > 0.f)
+		{
+			percent_count++;
+			total_percent += column.percent;
+			const float percent_width = column.ResolvePercent(target);
+			guess[MinGuess] += column.min;
+			guess[PercentageGuess] += percent_width;
+			guess[SpecifiedGuess] += percent_width;
+			guess[MaxGuess] += percent_width;
+			increase[PercentageGuess] += percent_width - column.min;
+		}
+		else if (column.constrained)
+		{
+			fixed_count++;
+			total_fixed_max += column.max;
+			guess[MinGuess] += column.min;
+			guess[PercentageGuess] += column.min;
+			guess[SpecifiedGuess] += column.max;
+			guess[MaxGuess] += column.max;
+			increase[SpecifiedGuess] += column.max - column.min;
+		}
+		else
+		{
+			auto_count++;
+			total_auto_max += column.max;
+			guess[MinGuess] += column.min;
+			guess[PercentageGuess] += column.min;
+			guess[SpecifiedGuess] += column.min;
+			guess[MaxGuess] += column.max;
+			increase[MaxGuess] += column.max - column.min;
+		}
+	}
+
+	Vector<float> sizes(count, 0.f);
+	target = Math::Max(target, guess[MinGuess]);
+	int starting_guess = AboveMax;
+	for (int i = MinGuess; i != AboveMax; i++)
+	{
+		if (guess[i] >= target)
+		{
+			starting_guess = i;
+			break;
+		}
+	}
+
+	// Each case hands the rounding remainder to the last column it grows.
+	float remaining = 0.f;
+	int last = -1;
+	auto grow = [&](int i, float base, float delta) {
+		sizes[i] = base + delta;
+		remaining -= delta;
+		last = i;
+	};
+	switch (starting_guess)
+	{
+	case MinGuess:
+		for (int i = 0; i < count; i++)
+			if (!columns[i].merged)
+				sizes[i] = columns[i].min;
+		break;
+	case PercentageGuess:
+	{
+		const float distributable = target - guess[MinGuess];
+		remaining = distributable;
+		for (int i = 0; i < count; i++)
+		{
+			const ColumnWidths& column = columns[i];
+			if (column.merged)
+				continue;
+			if (column.percent > 0.f)
+			{
+				const float column_increase = column.ResolvePercent(target) - column.min;
+				grow(i, column.min,
+					increase[PercentageGuess] > 0.f ? distributable * column_increase / increase[PercentageGuess] : distributable / percent_count);
+			}
+			else
+				sizes[i] = column.min;
+		}
+	}
+	break;
+	case SpecifiedGuess:
+	{
+		const float distributable = target - guess[PercentageGuess];
+		remaining = distributable;
+		for (int i = 0; i < count; i++)
+		{
+			const ColumnWidths& column = columns[i];
+			if (column.merged)
+				continue;
+			if (column.percent > 0.f)
+				sizes[i] = column.ResolvePercent(target);
+			else if (column.constrained)
+				grow(i, column.min,
+					increase[SpecifiedGuess] > 0.f ? distributable * (column.max - column.min) / increase[SpecifiedGuess]
+												   : distributable / fixed_count);
+			else
+				sizes[i] = column.min;
+		}
+	}
+	break;
+	case MaxGuess:
+	{
+		const float distributable = target - guess[SpecifiedGuess];
+		// An exact match (usually an automatic table width) gives every column its max-content width.
+		const bool exact = target == guess[MaxGuess];
+		remaining = exact ? 0.f : distributable;
+		for (int i = 0; i < count; i++)
+		{
+			const ColumnWidths& column = columns[i];
+			if (column.merged)
+				continue;
+			if (column.percent > 0.f)
+				sizes[i] = column.ResolvePercent(target);
+			else if (column.constrained || exact)
+				sizes[i] = column.max;
+			else
+				grow(i, column.min,
+					increase[MaxGuess] > 0.f ? distributable * (column.max - column.min) / increase[MaxGuess] : distributable / auto_count);
+		}
+		if (exact)
+			last = -1;
+	}
+	break;
+	case AboveMax:
+	{
+		const float distributable = target - guess[MaxGuess];
+		remaining = distributable;
+		for (int i = 0; i < count; i++)
+		{
+			const ColumnWidths& column = columns[i];
+			if (column.merged)
+				continue;
+			if (auto_count > 0)
+			{
+				// Auto columns grow, in proportion to their max-content widths.
+				if (column.percent > 0.f)
+					sizes[i] = column.ResolvePercent(target);
+				else if (column.constrained)
+					sizes[i] = column.max;
+				else
+					grow(i, column.max, total_auto_max > 0.f ? distributable * column.max / total_auto_max : distributable / auto_count);
+			}
+			else if (fixed_count > 0 && constrained_target)
+			{
+				if (column.percent > 0.f)
+					sizes[i] = column.ResolvePercent(target);
+				else
+					grow(i, column.max, total_fixed_max > 0.f ? distributable * column.max / total_fixed_max : distributable / fixed_count);
+			}
+			else if (percent_count > 0 && column.percent > 0.f)
+			{
+				grow(i, column.ResolvePercent(target),
+					total_percent != 0.f ? distributable * column.percent / total_percent : distributable / percent_count);
+			}
+		}
+	}
+	break;
+	}
+	if (last >= 0)
+		sizes[last] += remaining;
+	return sizes;
+}
+
+// Distributes a cell spanning several columns over them, as Chromium's DistributeColspanCellToColumnsAuto does.
+void DistributeColspanCell(const CellWidths& cell, ColumnWidths* columns, const int count, const float spacing)
+{
+	float inner_spacing = 0.f;
+	bool first = true;
+	for (int i = 0; i < count; i++)
+	{
+		if (columns[i].merged)
+			continue;
+		if (!first)
+			inner_spacing += spacing;
+		first = false;
+	}
+	const float cell_min = Math::Max(0.f, cell.min - inner_spacing);
+	const float cell_max = Math::Max(0.f, cell.max - inner_spacing);
+
+	if (cell.percent > 0.f)
+	{
+		float columns_percent = 0.f, nonpercent_max = 0.f;
+		int all_count = 0, percent_count = 0, nonpercent_count = 0;
+		for (int i = 0; i < count; i++)
+		{
+			if (columns[i].merged)
+				continue;
+			all_count++;
+			if (columns[i].percent > 0.f)
+			{
+				percent_count++;
+				columns_percent += columns[i].percent;
+			}
+			else
+			{
+				nonpercent_count++;
+				nonpercent_max += columns[i].max;
+			}
+		}
+		const float surplus = cell.percent - columns_percent;
+		if (surplus > 0.f && all_count > percent_count)
+		{
+			for (int i = 0; i < count; i++)
+			{
+				if (columns[i].percent > 0.f || columns[i].merged)
+					continue;
+				columns[i].percent = nonpercent_max != 0.f ? surplus * columns[i].max / nonpercent_max : surplus / nonpercent_count;
+			}
+		}
+	}
+
+	Vector<float> sizes = DistributeWidth(cell_min, columns, count, true);
+	for (int i = 0; i < count; i++)
+		columns[i].min = Math::Max(columns[i].min, sizes[i]);
+	sizes = DistributeWidth(cell_max, columns, count, cell.constrained);
+	for (int i = 0; i < count; i++)
+		columns[i].max = Math::Max(Math::Max(columns[i].min, columns[i].max), sizes[i]);
+}
+
+bool HasBorder(Element* element)
+{
+	const ComputedValues& computed = element->GetComputedValues();
+	return computed.border_top_width() > 0.f || computed.border_right_width() > 0.f || computed.border_bottom_width() > 0.f ||
+		computed.border_left_width() > 0.f;
+}
