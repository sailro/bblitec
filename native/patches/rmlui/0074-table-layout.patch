+void TableFormattingContext::ReportUnrepresentedParts() const
+{
+	SystemInterface* system = GetSystemInterface();
+	if (collapsed_borders)
+	{
+		Element* bordered = HasBorder(element_table) ? element_table : nullptr;
+		for (const TableGrid::Row& row : grid.rows)
+			for (Element* element : {row.element_row, row.element_group})
+				if (!bordered && element && HasBorder(element))
+					bordered = element;
+		for (const TableGrid::Column& column : grid.columns)
+			for (Element* element : {column.element_column, column.element_group, column.element_cell})
+				if (!bordered && element && HasBorder(element))
+					bordered = element;
+		for (const TableGrid::Cell& cell : grid.cells)
+			if (!bordered && HasBorder(cell.element_cell))
+				bordered = cell.element_cell;
+		if (bordered)
+			system->LayoutNotRepresented(bordered, "Collapsed table borders (border-collapse: collapse beside a border)");
+	}
+
+	// The first header group lays out above every other row and the first footer group below them (CSS 2.1 17.2). Row groups
+	// keep their document order here.
+	bool header_seen = false, footer_seen = false;
+	for (int i = 0; i < (int)grid.rows.size(); i++)
+	{
+		Element* group = grid.rows[i].element_group;
+		if (!group)
+			continue;
+		const String& tag = group->GetTagName();
+		if (tag == "thead" && !header_seen)
+		{
+			header_seen = true;
+			if (i != 0)
+				system->LayoutNotRepresented(group, "A table header group after other rows");
+		}
+		if (tag == "tfoot" && !footer_seen)
+		{
+			footer_seen = true;
+			if (i + grid.rows[i].group_span != (int)grid.rows.size())
+				system->LayoutNotRepresented(group, "A table footer group before other rows");
+		}
+	}
+}
+
+void TableFormattingContext::DetermineAutoColumnWidths(TrackBoxList& columns, float& table_content_width) const
+{
+	const int num_columns = (int)grid.columns.size();
+	const bool auto_width = element_table->GetComputedValues().width().type == Style::Width::Auto;
+	if (num_columns == 0)
+	{
+		table_content_width =
+			Math::Clamp(auto_width ? 0.f : Math::Max(0.f, table_initial_content_size.x), table_min_size.x, table_max_size.x);
+		return;
+	}
+
+	// Column elements give their columns a width, as TableTypes::CreateColumn reads them; a column group's width is the default
+	// of its columns.
+	Vector<ColumnWidths> widths(num_columns);
+	Element* group = nullptr;
+	int group_remaining = 0;
+	for (int i = 0; i < num_columns; i++)
+	{
+		if (grid.columns[i].element_group)
+		{
+			group = grid.columns[i].element_group;
+			group_remaining = grid.columns[i].group_span;
+		}
+		Element* group_here = group_remaining-- > 0 ? group : nullptr;
+		Element* column_element = grid.columns[i].element_column;
+		for (int j = i - 1; !column_element && j >= 0; j--)
+			if (grid.columns[j].element_column && j + grid.columns[j].column_span > i)
+				column_element = grid.columns[j].element_column;
+		if (!column_element && !group_here)
+			continue;
+		ColumnWidths& column = widths[i];
+		column.sized = true;
+		const ComputedValues* computed = column_element ? &column_element->GetComputedValues() : nullptr;
+		float width = -1.f;
+		if (computed && computed->width().type == Style::Width::Length)
+			width = computed->width().value;
+		else if (group_here && group_here->GetComputedValues().width().type == Style::Width::Length)
+			width = group_here->GetComputedValues().width().value;
+		if (computed && computed->min_width().type == Style::MinWidth::Length)
+			column.min = computed->min_width().value;
+		if (computed && computed->width().type == Style::Width::Percentage)
+			column.percent = computed->width().value;
+		if (width >= 0.f)
+		{
+			column.max = Math::Max(width, column.min);
+			column.constrained = true;
+		}
+		column.merged = !(width > 0.f || column.percent > 0.f);
+	}
+
+	// The cells spanning one column merge into their column; the wider ones distribute over the columns they span.
