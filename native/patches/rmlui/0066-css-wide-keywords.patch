+PropertySpecification::CssWideKeyword PropertySpecification::ParseCssWideKeyword(const String& value)
+{
+	size_t begin = 0, end = value.size();
+	while (begin < end && StringUtilities::IsWhitespace(value[begin]))
+		begin++;
+	while (end > begin && StringUtilities::IsWhitespace(value[end - 1]))
+		end--;
+	const auto is = [&](const char* keyword) {
+		for (size_t i = begin; i < end; i++, keyword++)
+		{
+			const char c = value[i];
+			if (!*keyword || (c >= 'A' && c <= 'Z' ? char(c - 'A' + 'a') : c) != *keyword)
+				return false;
+		}
+		return !*keyword;
+	};
+	if (is("inherit"))
+		return CssWideKeyword::Inherit;
+	if (is("initial"))
+		return CssWideKeyword::Initial;
+	if (is("unset"))
+		return CssWideKeyword::Unset;
+	if (is("revert") || is("revert-layer"))
+		return CssWideKeyword::Revert;
+	return CssWideKeyword::None;
+}
+
+PropertySpecification::CssWideKeyword PropertySpecification::GetCssWideKeyword(const Property& property)
+{
+	return property.unit == Unit::CSS_WIDE_KEYWORD ? ParseCssWideKeyword(property.value.GetReference<String>()) : CssWideKeyword::None;
+}
+
+// A CSS-wide keyword's declaration: unset is inherit or initial as the property inherits, and an inherited property's
+// initial its initial value. The cascade resolves the others; initial is the absence of a declaration there, which the
+// initial value of a property that does not inherit stands for.
+static Property KeywordProperty(const PropertyDefinition* definition, PropertySpecification::CssWideKeyword keyword)
+{
+	using Keyword = PropertySpecification::CssWideKeyword;
+	if (keyword == Keyword::Unset)
+		keyword = definition->IsInherited() ? Keyword::Inherit : Keyword::Initial;
+	if (keyword == Keyword::Initial && definition->IsInherited())
+		return *definition->GetDefaultValue();
+	Property property(String(keyword == Keyword::Inherit ? "inherit" : keyword == Keyword::Initial ? "initial" : "revert"), Unit::CSS_WIDE_KEYWORD);
+	property.definition = definition;
+	return property;
+}
