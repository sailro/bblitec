 		return Property{FiltersPtr(std::move(filter)), Unit::FILTER};
 	}
 
+	// Shadow lists interpolate shadow by shadow, the shorter padded with transparent zero shadows of the longer
+	// one's inset; an inset paired with an outer shadow swaps the whole list discretely (CSS Backgrounds 3 ┬º7.2).
+	if (p0.unit == Unit::BOXSHADOWLIST && p1.unit == Unit::BOXSHADOWLIST)
+	{
+		const auto& s0 = p0.value.GetReference<BoxShadowList>();
+		const auto& s1 = p1.value.GetReference<BoxShadowList>();
+		const size_t N = std::max(s0.size(), s1.size());
+		BoxShadowList result(N);
+		for (size_t i = 0; i < N; i++)
+		{
+			BoxShadow padding;
+			padding.color = ColourbPremultiplied(0, 0);
+			padding.offset_x = padding.offset_y = padding.blur_radius = padding.spread_distance = NumericValue{0.f, Unit::PX};
+			padding.inset = (i < s0.size() ? s0[i] : s1[i]).inset;
+			const BoxShadow& a = (i < s0.size() ? s0[i] : padding);
+			const BoxShadow& b = (i < s1.size() ? s1[i] : padding);
+			if (a.inset != b.inset)
+				return p_discrete;
+			BoxShadow& shadow = result[i];
+			shadow.inset = a.inset;
+			shadow.color = InterpolateColour(a.color.ToNonPremultiplied(), b.color.ToNonPremultiplied(), alpha).ToPremultiplied();
+			shadow.offset_x = InterpolateNumericValue(a.offset_x, b.offset_x, alpha, element, nullptr);
+			shadow.offset_y = InterpolateNumericValue(a.offset_y, b.offset_y, alpha, element, nullptr);
+			shadow.blur_radius = InterpolateNumericValue(a.blur_radius, b.blur_radius, alpha, element, nullptr);
+			shadow.spread_distance = InterpolateNumericValue(a.spread_distance, b.spread_distance, alpha, element, nullptr);
+			// An easing past its ends extrapolates; a blur radius stays nonnegative.
+			shadow.blur_radius.number = std::max(shadow.blur_radius.number, 0.f);
+		}
+		return Property{Variant(std::move(result)), Unit::BOXSHADOWLIST};
+	}
+
