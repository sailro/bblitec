Retain sized faces through owning handles and a bounded hot cache. Keep live-handle
identity through weak entries and share fallback bitmap ownership across eviction.

diff --git a/Include/RmlUi/Core/FontFaceCache.h b/Include/RmlUi/Core/FontFaceCache.h
new file mode 100644
index 0000000..a51a3e3
--- /dev/null
+++ b/Include/RmlUi/Core/FontFaceCache.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include <list>
+#include <map>
+#include <memory>
+#include <utility>
+
+namespace Rml {
+
+// Retain a bounded hot set. Live handles own their faces independently of the
+// cache, including inherited styles and detached elements. Weak entries preserve
+// identity for those faces without retaining obsolete animation/resize sizes.
+template <typename Key, typename Value, size_t Capacity = 32>
+class FontFaceCache {
+public:
+	FontFaceCache() = default;
+	FontFaceCache(const FontFaceCache&) = delete;
+	FontFaceCache& operator=(const FontFaceCache&) = delete;
+
+	template <typename Create>
+	std::shared_ptr<Value> Get(const Key& key, Create create)
+	{
+		// Bound cleanup work even when many live styles retain distinct sizes.
+		for (size_t budget = 4; budget && !faces.empty(); --budget)
+		{
+			if (cleanup == faces.end())
+				cleanup = faces.begin();
+			auto entry = cleanup++;
+			if (entry->second.expired())
+				faces.erase(entry);
+		}
+
+		std::shared_ptr<Value> face;
+		auto found = faces.find(key);
+		if (found != faces.end())
+			face = found->second.lock();
+		if (!face)
+		{
+			face = create();
+			if (!face)
+				return nullptr;
+			faces[key] = face;
+		}
+		for (auto it = recent.begin(); it != recent.end(); ++it)
+			if (*it == face)
+			{
+				recent.splice(recent.end(), recent, it);
+				return face;
+			}
+		recent.push_back(face);
+		if (recent.size() > Capacity)
+			recent.pop_front();
+		return face;
+	}
+
+	template <typename Release>
+	void Clear(Release release)
+	{
+		for (auto& entry : faces)
+			if (auto face = entry.second.lock())
+				release(*face);
+		recent.clear();
+		faces.clear();
+		cleanup = faces.end();
+	}
+	void Clear() { Clear([](Value&) {}); }
+
+private:
+	std::map<Key, std::weak_ptr<Value>> faces;
+	typename decltype(faces)::iterator cleanup = faces.end();
+	std::list<std::shared_ptr<Value>> recent;
+};
+
+} // namespace Rml
