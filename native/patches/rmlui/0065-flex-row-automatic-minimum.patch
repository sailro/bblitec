+float LayoutDetails::GetMinContentWidth(Element* element, const Box& box, float height, Vector2f containing_block)
+{
+	Box measure = box;
+	measure.SetContent({0.f, height});
+	containing_block = Math::Max(containing_block, Vector2f(0.f));
+	return MeasureOnce(element, {containing_block, true, measure}, [&] {
+		RootBox root(containing_block);
+		return FormattingContext::FormatIndependent(&root, element, &measure, FormattingContextType::Block)->GetShrinkToFitWidth();
+	});
+}
