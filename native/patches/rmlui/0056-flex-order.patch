 	FirstCustomId = NumDefinedIds,
diff --git a/Source/Core/Element.cpp b/Source/Core/Element.cpp
index ae4263c..e784196 100644
--- a/Source/Core/Element.cpp
+++ b/Source/Core/Element.cpp
@@ -1975,6 +1975,10 @@ void Element::OnPropertyChange(const PropertyIdSet& changed_properties)
 		}
 	}
 
+	// A flex item's order re-indexes the stacking context it paints in.
+	if (changed_properties.Contains(PropertyId::Order) && parent)
+		parent->DirtyStackingContext();
+
 	// Dirty the background if it's changed.
 	if (border_radius_changed ||                                    //
 		changed_properties.Contains(PropertyId::BackgroundColor) || //
@@ -2464,9 +2468,25 @@ void Element::AddChildrenToStackingContext(Vector<StackingContextChild>& stackin
 {
 	bool is_flex_container = (GetDisplay() == Style::Display::Flex || GetDisplay() == Style::Display::Grid || GetDisplay() == Style::Display::InlineGrid);
 	const int num_children = (int)children.size();
+	const int num_dom_children = num_children - num_non_dom_children;
+	// A flex container's items paint in order-modified document order (CSS Flexbox 5.4).
+	const auto order = [](Element* element) { return element->GetProperty(PropertyId::Order)->Get<float>(); };
+	if (is_flex_container &&
+		std::any_of(children.begin(), children.begin() + num_dom_children, [&](const ElementPtr& child) { return order(child.get()) != 0.f; }))
+	{
+		Vector<Element*> items;
+		for (int i = 0; i < num_dom_children; ++i)
+			items.push_back(children[i].get());
+		std::stable_sort(items.begin(), items.end(), [&](Element* a, Element* b) { return order(a) < order(b); });
+		for (Element* item : items)
+			item->AddToStackingContext(stacking_children, true, false);
+		for (int i = num_dom_children; i < num_children; ++i)
+			children[i]->AddToStackingContext(stacking_children, true, true);
+		return;
+	}
 	for (int i = 0; i < num_children; ++i)
 	{
-		const bool is_non_dom_element = (i >= num_children - num_non_dom_children);
+		const bool is_non_dom_element = (i >= num_dom_children);
 		children[i]->AddToStackingContext(stacking_children, is_flex_container, is_non_dom_element);
 	}
 }
