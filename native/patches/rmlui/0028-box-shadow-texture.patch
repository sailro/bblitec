+		return Vector<Slice>{{0.f, cut, 0.f, cut / size}, {cut, removed, texel, texel}, {cut + removed, size - cut, cut / size, 1.f}};
+	};
+	const Vector<Slice> columns = slices(0);
+	for (const Slice& y : slices(1))
+		for (const Slice& x : columns)
+			MeshUtilities::GenerateQuad(mesh, -info.element_offset_in_texture + Vector2f(x.position, y.position), Vector2f(x.length, y.length),
+				ColourbPremultiplied(alpha, alpha), Vector2f(x.texture_start, y.texture_start), Vector2f(x.texture_end, y.texture_end));
