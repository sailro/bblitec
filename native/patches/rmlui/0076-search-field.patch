+void InputTypeText::LayoutCancelButton()
+{
+	if (!cancel_button)
+		return;
+	// Chromium's LayoutThemeDefault::AdjustSearchFieldCancelButtonStyle: 9px at its 13px control font, scaled with the
+	// font size and rounded, within 5px to 21px, in CSS pixels.
+	const float dp_ratio = ElementUtilities::GetDensityIndependentPixelRatio(element);
+	const float font_size = element->GetComputedValues().font_size() / dp_ratio;
+	const float side = Math::Round(Math::Clamp(9.f * font_size / 13.f, 5.f, 21.f)) * dp_ratio;
+
+	const Box& field = element->GetBox();
+	const Vector2f content_position = field.GetPosition(BoxArea::Content);
+	const Vector2f content_size = field.GetSize(BoxArea::Content);
+	const ComputedValues& computed = cancel_button->GetComputedValues();
+	const float margin_left = ResolveValue(computed.margin_left(), content_size.x);
+	const float margin_right = ResolveValue(computed.margin_right(), content_size.x);
+
+	Box box{Vector2f(side)};
+	box.SetEdge(BoxArea::Margin, BoxEdge::Left, margin_left);
+	box.SetEdge(BoxArea::Margin, BoxEdge::Right, margin_right);
+	cancel_button->SetBox(box);
+	// A flex item at the end of the field's content, centered across it; it never scrolls with the text.
+	cancel_button->SetOffset(
+		content_position + Vector2f(content_size.x - margin_right - side, 0.5f * (content_size.y - side)), element, true);
+	widget->SetRightReserve(margin_left + side + margin_right);
+}
+
+void InputTypeText::UpdateCancelButtonVisibility()
+{
+	if (!cancel_button)
+		return;
+	// Chromium's SearchInputType::UpdateCancelButtonVisibility.
+	if (widget->GetAttributeValue().empty())
+	{
+		cancel_button->SetProperty("opacity", "0");
+		cancel_button->SetProperty("pointer-events", "none");
+	}
+	else
+	{
+		cancel_button->RemoveProperty("opacity");
+		cancel_button->RemoveProperty("pointer-events");
+	}
+}
