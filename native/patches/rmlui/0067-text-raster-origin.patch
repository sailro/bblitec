+++ b/Include/RmlUi/Core/ElementText.h
@@ -87,6 +87,7 @@
 		Texture texture;
 	};
 	Vector<TexturedGeometry> geometry;
+	Vector2f geometry_origin = {0, 0};
 
 	// The decoration geometry we've generated for this string.
 	UniquePtr<Geometry> decoration;
