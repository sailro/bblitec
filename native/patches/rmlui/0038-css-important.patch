diff --git a/Source/Core/StyleSheetParser.cpp b/Source/Core/StyleSheetParser.cpp
index 2f88e2d..1b7dff0 100644
--- a/Source/Core/StyleSheetParser.cpp
+++ b/Source/Core/StyleSheetParser.cpp
@@ -140,7 +140,51 @@ public:
 		properties(properties), specification(specification)
 	{}
 
-	bool Parse(const String& name, const String& value) override { return specification.ParsePropertyDeclaration(properties, name, value); }
+	bool Parse(const String& name, const String& value) override
+	{
+		// A trailing '!important' (ASCII case-insensitive, optional space after '!') marks the declaration.
+		String declared = value;
+		bool important = false;
+		const String lower = StringUtilities::ToLower(declared);
+		if (lower.size() > 9 && lower.compare(lower.size() - 9, 9, "important") == 0)
+		{
+			size_t mark = lower.size() - 9;
+			while (mark > 0 && StringUtilities::IsWhitespace(lower[mark - 1]))
+				--mark;
+			if (mark > 0 && lower[mark - 1] == '!')
+			{
+				important = true;
+				declared = StringUtilities::StripWhitespace(declared.substr(0, mark - 1));
+			}
+		}
+		PropertyDictionary parsed;
+		if (!specification.ParsePropertyDeclaration(parsed, name, declared))
+			return false;
+		// A later normal declaration does not replace an important one in the same block.
+		const auto keep = [important](const Property* existing) { return existing && existing->important && !important; };
+		for (auto [id, property] : parsed.GetProperties())
+		{
+			if (keep(properties.GetProperty(id)))
+				continue;
+			property.important = important;
+			properties.SetProperty(id, property);
+		}
+		for (auto [custom_name, property] : parsed.GetCustomProperties())
+		{
+			if (keep(properties.GetCustomProperty(custom_name)))
+				continue;
+			property.important = important;
+			properties.SetCustomProperty(custom_name, property);
+		}
+		for (auto [id, property] : parsed.GetVarShorthands())
+		{
+			if (keep(properties.GetVarShorthand(id)))
+				continue;
+			property.important = important;
+			properties.SetVarShorthand(id, property);
+		}
+		return true;
+	}
 };
 
