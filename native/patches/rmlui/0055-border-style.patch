+void GeometryBackgroundBorder::DrawStyledBorder(const BorderMetrics& metrics, EdgeSizes edge_sizes, const ColourbPremultiplied border_colors[4],
+	const Style::BorderStyle border_styles[4])
+{
+	const auto drawn = [&](int side) { return edge_sizes[side] > 0 && border_colors[side].alpha > 0; };
+	const auto pattern = [&](int side, int path_length, bool closed_path) {
+		return border_styles[side] == Style::BorderStyle::Dashed ? DashedStroke(edge_sizes[side], path_length, closed_path) : DashPattern{};
+	};
+	const bool rounded = std::any_of(metrics.outer_radii.begin(), metrics.outer_radii.end(), [](Vector2f R) { return R.x > 0 && R.y > 0; });
+
+	if (!rounded)
+	{
+		// Each side runs from its first corner to its second, left to right or top to bottom, over the whole outer edge; its region is
+		// the trapezoid the miters to the inner corners cut.
+		const Corner runs[4][2] = {{TOP_LEFT, TOP_RIGHT}, {TOP_RIGHT, BOTTOM_RIGHT}, {BOTTOM_LEFT, BOTTOM_RIGHT}, {TOP_LEFT, BOTTOM_LEFT}};
+		const Vector2f inward[4] = {{0, 1}, {-1, 0}, {0, -1}, {1, 0}};
+		for (int side = 0; side < 4; side++)
+		{
+			if (!drawn(side))
+				continue;
+			const Vector2f outer0 = metrics.positions_outer[runs[side][0]];
+			const Vector2f outer1 = metrics.positions_outer[runs[side][1]];
+			const Vector<Vector2f> region = {outer0, outer1, metrics.positions_inner[runs[side][1]], metrics.positions_inner[runs[side][0]]};
+			const float length = (outer1 - outer0).Magnitude();
+			if (length <= 0)
+				continue;
+			const Vector2f along = (outer1 - outer0) / length;
+			const Vector2f across = inward[side] * edge_sizes[side];
+			ForEachDash(pattern(side, Math::RoundToInteger(length), false), 0.f, length, [&](float on0, float on1) {
+				const Vector2f start = outer0 + along * on0;
+				const Vector2f end = outer0 + along * on1;
+				FillPolygon(ClipConvex({start, end, end + across, start + across}, region), border_colors[side]);
+			});
+		}
+		return;
+	}
+
+	// The border's spokes, each an (outer, inner) pair whose midpoints trace the centerline, clockwise from the top edge's start.
+	struct Spoke {
+		Vector2f outer, inner;
+		// The side of the segment that ends at this spoke.
+		int side = TOP;
+	};
+	Vector<Spoke> spokes;
+	const auto corner_spokes = [&](int corner) {
+		const int side0 = (corner + 3) % 4;
+		const int side1 = corner;
+		const Vector2f pos_outer = metrics.positions_outer[corner];
+		const Vector2f pos_inner = metrics.positions_inner[corner];
+		const Vector2f R = metrics.outer_radii[corner];
+		const Vector2f r = metrics.inner_radii[corner];
+		Vector<Spoke> result;
+		if (R.x <= 0 || R.y <= 0)
+		{
+			result.push_back({pos_outer, pos_inner, side0});
+			return result;
+		}
+		const Vector2f center = metrics.positions_circle_center[corner];
+		const float a0 = float(corner + 2) * 0.5f * Math::RMLUI_PI;
+		const float a1 = float(corner + 3) * 0.5f * Math::RMLUI_PI;
+		const int num_points = Math::Clamp(3 + Math::RoundToInteger(Math::Max(R.x, R.y)), 4, 128);
+		// The miter from the outer to the inner corner divides the corner between its two sides.
+		const auto miter = [&](const Spoke& spoke) { return Cross(pos_inner - pos_outer, (spoke.outer + spoke.inner) * 0.5f - pos_outer); };
+		float first_miter = 0;
+		bool past_miter = false;
+		for (int i = 0; i < num_points; i++)
+		{
+			const float a = Math::Lerp(float(i) / float(num_points - 1), a0, a1);
+			const Vector2f unit(Math::Cos(a), Math::Sin(a));
+			Spoke spoke{center + unit * R, r.x > 0 && r.y > 0 ? center + unit * r : pos_inner, past_miter ? side1 : side0};
+			const float m = miter(spoke);
+			if (i == 0)
+				first_miter = m;
+			else if (!past_miter && (m < 0) != (first_miter < 0))
+			{
+				// Split the segment where the spoke midpoints cross the miter.
+				const Spoke& previous = result.back();
+				const float previous_m = miter(previous);
+				const float t = previous_m / (previous_m - m);
+				result.push_back({Math::Lerp(t, previous.outer, spoke.outer), Math::Lerp(t, previous.inner, spoke.inner), side0});
+				past_miter = true;
+				spoke.side = side1;
+			}
+			result.push_back(spoke);
+		}
+		return result;
+	};
+	const Vector<Spoke> top_left = corner_spokes(TOP_LEFT);
+	spokes.push_back(top_left.back());
+	for (int corner : {TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT})
+	{
+		const Vector<Spoke> next = corner_spokes(corner);
+		spokes.insert(spokes.end(), next.begin(), next.end());
+	}
+	spokes.insert(spokes.end(), top_left.begin(), top_left.end());
+
+	Vector<float> distances(spokes.size(), 0.f);
+	for (size_t i = 1; i < spokes.size(); i++)
+		distances[i] = distances[i - 1] +
+			((spokes[i].outer + spokes[i].inner) * 0.5f - (spokes[i - 1].outer + spokes[i - 1].inner) * 0.5f).Magnitude();
+	// Chromium dashes the centerline by its whole-pixel length.
+	const int path_length = int(distances.back());
+	DashPattern patterns[4];
+	for (int side = 0; side < 4; side++)
+		patterns[side] = pattern(side, path_length, true);
+
+	for (size_t i = 1; i < spokes.size(); i++)
+	{
+		const int side = spokes[i].side;
+		const float s0 = distances[i - 1], s1 = distances[i];
+		if (!drawn(side) || s1 <= s0)
+			continue;
+		const Spoke& a = spokes[i - 1];
+		const Spoke& b = spokes[i];
+		ForEachDash(patterns[side], s0, s1, [&](float on0, float on1) {
+			const float t0 = (on0 - s0) / (s1 - s0), t1 = (on1 - s0) / (s1 - s0);
+			FillSpokes(Math::Lerp(t0, a.outer, b.outer), Math::Lerp(t0, a.inner, b.inner), Math::Lerp(t1, a.outer, b.outer),
+				Math::Lerp(t1, a.inner, b.inner), border_colors[side]);
+		});
+	}
+}
+
+void GeometryBackgroundBorder::FillPolygon(const Vector<Vector2f>& polygon, ColourbPremultiplied color)
+{
+	if (polygon.size() < 3)
+		return;
+	const int offset_vertices = (int)vertices.size();
+	for (Vector2f point : polygon)
+		DrawPoint(point, color);
+	for (int i = 1; i + 1 < (int)polygon.size(); i++)
+	{
+		indices.push_back(offset_vertices);
+		indices.push_back(offset_vertices + i + 1);
+		indices.push_back(offset_vertices + i);
+	}
+}
+
+void GeometryBackgroundBorder::FillSpokes(Vector2f outer0, Vector2f inner0, Vector2f outer1, Vector2f inner1, ColourbPremultiplied color)
