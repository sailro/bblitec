+	// A dashed stroke's on and off lengths along its path, as Chromium's StyledStrokeData computes them; solid draws the whole path.
+	struct DashPattern {
+		bool solid = true;
+		float dash = 0, gap = 0;
+	};
+
+	// The gap that spaces whole dashes along the path closest to the preferred gap (StyledStrokeData::SelectBestDashGap).
+	float SelectBestDashGap(float stroke_length, float dash_length, float gap_length, bool closed_path)
+	{
+		const float available_length = closed_path ? stroke_length : stroke_length + gap_length;
+		const float min_num_dashes = std::floor(available_length / (dash_length + gap_length));
+		const float max_num_dashes = min_num_dashes + 1;
+		const float min_num_gaps = closed_path ? min_num_dashes : min_num_dashes - 1;
+		const float max_num_gaps = closed_path ? max_num_dashes : max_num_dashes - 1;
+		const float min_gap = (stroke_length - min_num_dashes * dash_length) / min_num_gaps;
+		const float max_gap = (stroke_length - max_num_dashes * dash_length) / max_num_gaps;
+		return (max_gap <= 0) || (std::fabs(min_gap - gap_length) < std::fabs(max_gap - gap_length)) ? min_gap : max_gap;
+	}
+
+	// A dash is two widths long from three pixels on (else three), a gap one (else two). A path too short for two dashes is solid; one
+	// too short for two dashes and a gap (two gaps when closed) scales both.
+	DashPattern DashedStroke(float width, int path_length, bool closed_path)
+	{
+		const float dash_length = width * (width >= 3 ? 2.f : 3.f);
+		const float gap_length = width * (width >= 3 ? 1.f : 2.f);
+		const float length = float(path_length);
+		if (length <= dash_length * 2)
+			return {};
+		const float two_dashes_with_gap_length = 2 * dash_length + gap_length + (closed_path ? gap_length : 0.f);
+		if (length <= two_dashes_with_gap_length)
+		{
+			const float multiplier = length / two_dashes_with_gap_length;
+			return {false, dash_length * multiplier, gap_length * multiplier};
+		}
+		return {false, dash_length, SelectBestDashGap(length, dash_length, gap_length, closed_path)};
+	}
+
+	// Calls emit(on0, on1) for each part of [begin, end) the pattern draws; its first dash starts at zero.
+	template <typename Emit>
+	void ForEachDash(const DashPattern& pattern, float begin, float end, Emit&& emit)
+	{
+		if (pattern.solid)
+		{
+			if (end > begin)
+				emit(begin, end);
+			return;
+		}
+		const float period = pattern.dash + pattern.gap;
+		for (int k = int(std::floor(begin / period)); float(k) * period < end; k++)
+		{
+			const float on0 = Math::Max(float(k) * period, begin);
+			const float on1 = Math::Min(float(k) * period + pattern.dash, end);
+			if (on1 > on0)
+				emit(on0, on1);
+		}
+	}
+
+	float Cross(Vector2f a, Vector2f b)
+	{
+		return a.x * b.y - a.y * b.x;
+	}
+
+	// The part of a convex polygon inside a convex region.
+	Vector<Vector2f> ClipConvex(Vector<Vector2f> polygon, const Vector<Vector2f>& region)
+	{
+		Vector2f centroid;
+		for (Vector2f point : region)
+			centroid += point / float(region.size());
+		for (size_t i = 0; i < region.size() && !polygon.empty(); i++)
+		{
+			const Vector2f a = region[i];
+			const Vector2f b = region[(i + 1) % region.size()];
+			const float inside_sign = Cross(b - a, centroid - a) < 0 ? -1.f : 1.f;
+			const auto distance = [&](Vector2f p) { return inside_sign * Cross(b - a, p - a); };
+			Vector<Vector2f> clipped;
+			for (size_t j = 0; j < polygon.size(); j++)
+			{
+				const Vector2f p = polygon[j];
+				const Vector2f q = polygon[(j + 1) % polygon.size()];
+				const float dp = distance(p), dq = distance(q);
+				if (dp >= 0)
+					clipped.push_back(p);
+				if ((dp >= 0) != (dq >= 0))
+					clipped.push_back(p + (q - p) * (dp / (dp - dq)));
+			}
+			polygon = std::move(clipped);
+		}
+		return polygon;
+	}
+
+} // namespace
