 }
@@ -181,5 +184,39 @@ void ElementImage::GenerateGeometry()
 	const RenderBox render_box = GetRenderBox(BoxArea::Content);
 
-	MeshUtilities::GenerateQuad(mesh, render_box.GetFillOffset(), render_box.GetFillSize(), quad_colour, texcoords[0], texcoords[1]);
+	// Object fitting changes the painted image, never its CSS layout box.
+	// Keyword order is shared with the object-fit property specification.
+	enum class ObjectFit { Fill, Contain, Cover, None, ScaleDown };
+	const auto fit = static_cast<ObjectFit>(GetProperty(PropertyId::ObjectFit)->Get<int>());
+	const Vector2f box_size = render_box.GetFillSize();
+	const Vector2f natural_size = (rect_source == RectSource::None ? Vector2f(texture.GetDimensions()) : rect.Size()) * dimensions_scale;
+	Vector2f fitted_size = box_size;
+	if (fit != ObjectFit::Fill && natural_size.x > 0 && natural_size.y > 0)
+	{
+		const float contain_scale = Math::Min(box_size.x / natural_size.x, box_size.y / natural_size.y);
+		float scale = 1.0f;
+		if (fit == ObjectFit::Contain) scale = contain_scale;
+		else if (fit == ObjectFit::Cover) scale = Math::Max(box_size.x / natural_size.x, box_size.y / natural_size.y);
+		else if (fit == ObjectFit::ScaleDown) scale = Math::Min(1.0f, contain_scale);
+		fitted_size = natural_size * scale;
+	}
+	// Like Blink's image painter, snap the centred image and the content box to whole pixels, then clip the image to
+	// the box, mapping the UVs through the snapped image rectangle. Geometry renders at the rounded absolute offset.
+	const Vector2f offset = GetAbsoluteOffset(BoxArea::Border);
+	geometry_offset_fraction = offset - offset.Round();
+	const auto snapped = [&offset](Vector2f position, Vector2f size) {
+		Rectanglef rectangle = Rectanglef::FromPositionSize(offset + position, size);
+		Math::SnapToPixelGrid(rectangle);
+		return Rectanglef::FromPositionSize(rectangle.Position() - offset.Round(), rectangle.Size());
+	};
+	const Vector2f box_start = render_box.GetFillOffset();
+	const Rectanglef image = snapped(box_start + (box_size - fitted_size) * 0.5f, fitted_size);
+	const Rectanglef shown = image.Intersect(snapped(box_start, box_size));
+	if (shown.Width() > 0 && shown.Height() > 0)
+	{
+		const Vector2f uv_size = texcoords[1] - texcoords[0];
+		const Vector2f uv_start = texcoords[0] + (shown.TopLeft() - image.TopLeft()) / image.Size() * uv_size;
+		const Vector2f uv_end = texcoords[0] + (shown.BottomRight() - image.TopLeft()) / image.Size() * uv_size;
+		MeshUtilities::GenerateQuad(mesh, shown.TopLeft(), shown.Size(), quad_colour, uv_start, uv_end);
+	}
 
 	if (RenderManager* render_manager = GetRenderManager())
