+	// CSS cubic-bezier(): solve x(s) = t for the curve parameter s, then return y(s).
+	static float cubic_bezier(const float* points, float t)
+	{
+		if (t <= 0.f || t >= 1.f)
+			return t <= 0.f ? 0.f : 1.f;
+		const double cx = 3.0 * points[0], bx = 3.0 * (double(points[2]) - points[0]) - cx, ax = 1.0 - cx - bx;
+		const double cy = 3.0 * points[1], by = 3.0 * (double(points[3]) - points[1]) - cy, ay = 1.0 - cy - by;
+		const auto sample_x = [&](double s) { return ((ax * s + bx) * s + cx) * s; };
+		const auto slope_x = [&](double s) { return (3.0 * ax * s + 2.0 * bx) * s + cx; };
+		const double x = t;
+		double s = x;
+		for (int i = 0; i < 8; ++i)
+		{
+			const double error = sample_x(s) - x;
+			if (error > -1e-7 && error < 1e-7)
+				return float(((ay * s + by) * s + cy) * s);
+			const double slope = slope_x(s);
+			if (slope > -1e-6 && slope < 1e-6)
+				break;
+			s -= error / slope;
+		}
+		double low = 0.0, high = 1.0;
+		s = x;
+		for (int i = 0; i < 64; ++i)
+		{
+			const double sample = sample_x(s);
+			if (sample - x > -1e-7 && sample - x < 1e-7)
+				break;
+			if (x > sample)
+				low = s;
+			else
+				high = s;
+			s = 0.5 * (low + high);
+		}
+		return float(((ay * s + by) * s + cy) * s);
+	}
+
+	// CSS steps(), outside any before phase.
+	static float steps(const float* parameters, float t)
+	{
+		const float count = parameters[0];
+		const auto position = Tween::StepPosition(int(parameters[1]));
+		float step = Math::RoundDown(t * count);
+		if (position == Tween::StepPosition::JumpStart || position == Tween::StepPosition::JumpBoth)
+			step += 1.f;
+		if (t >= 0.f && step < 0.f)
+			step = 0.f;
+		const float jumps = position == Tween::StepPosition::JumpBoth ? count + 1.f : position == Tween::StepPosition::JumpNone ? count - 1.f : count;
+		if (t <= 1.f && step > jumps)
+			step = jumps;
+		return step / jumps;
+	}
