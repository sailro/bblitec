+// CSS 'contain' (CSS Containment 2): none, content, or any of layout, paint and style. Style containment scopes counters and quotes
+// only, so it changes nothing here; size containment fails to parse.
+class PropertyParserContain final : public PropertyParser {
+public:
+	bool ParseValue(Property& property, const String& value, const ParameterMap& /*parameters*/) const override
+	{
+		StringList tokens;
+		StringUtilities::ExpandString(tokens, StringUtilities::ToLower(value), ' ', true);
+		bool layout = false, paint = false, style = false;
+		if (tokens.size() == 1 && tokens[0] == "content")
+			layout = paint = true;
+		else if (tokens.size() != 1 || tokens[0] != "none")
+		{
+			for (const String& token : tokens)
+			{
+				bool* flag = token == "layout" ? &layout : token == "paint" ? &paint : token == "style" ? &style : nullptr;
+				if (!flag || *flag)
+					return false;
+				*flag = true;
+			}
+			if (tokens.empty())
+				return false;
+		}
+		const Style::Contain contain = layout && paint ? Style::Contain::LayoutPaint
+			: layout                                   ? Style::Contain::Layout
+			: paint                                    ? Style::Contain::Paint
+			                                           : Style::Contain::None;
+		property.value = Variant(static_cast<int>(contain));
+		property.unit = Unit::KEYWORD;
+		return true;
+	}
+};
+
