 namespace Rml {
 
+// The intrinsic widths measured in the open layout pass, by element and the inputs each was measured under.
+struct LayoutMeasures {
+	// What a measure depends on besides its element.
+	struct Inputs {
+		Vector2f containing_block;
+		bool operator==(const Inputs& other) const { return containing_block == other.containing_block; }
+	};
+	UnorderedMap<Element*, Vector<Pair<Inputs, float>>> widths;
+};
+
+static LayoutMeasures* layout_measures = nullptr;
+
+LayoutDetails::MeasurePass::MeasurePass() : measures(MakeUnique<LayoutMeasures>()), enclosing(layout_measures)
+{
+	if (enclosing)
+		*enclosing = {};
+	layout_measures = measures.get();
+}
+
+LayoutDetails::MeasurePass::~MeasurePass()
+{
+	layout_measures = enclosing;
+}
+
+// The width `measure` takes for `element` under `inputs`, measured once in the open layout pass.
+template <typename Measure>
+static float MeasureOnce(Element* element, const LayoutMeasures::Inputs& inputs, Measure measure)
+{
+	if (!layout_measures)
+		return measure();
+	for (const auto& measured : layout_measures->widths[element])
+		if (measured.first == inputs)
+			return measured.second;
+	const float width = measure();
+	layout_measures->widths[element].push_back({inputs, width});
+	return width;
+}
