+// CSS Box Sizing 4 §5.1 aspect-ratio: `auto || <ratio>`, a <ratio> being `<number [0,∞]> [ / <number [0,∞]> ]?`.
+// Returns width / height, or 0 for auto and degenerate ratios; `automatic` reports the auto keyword.
+static float ParseAspectRatio(const String& source, bool& automatic)
+{
+	auto fail = [] { throw std::runtime_error("UI aspect-ratio requires auto and/or a ratio of finite nonnegative numbers."); };
+	std::string_view input(source);
+	auto space = [&] {
+		while (!input.empty() && StringUtilities::IsWhitespace(input.front()))
+			input.remove_prefix(1);
+	};
+	auto number = [&] {
+		space();
+		float value = 0.f;
+		const auto parsed = number_parsing::from_chars(input.data(), input.data() + input.size(), value);
+		if (parsed.ec != std::errc{} || !std::isfinite(value) || value < 0.f)
+			fail();
+		input.remove_prefix(size_t(parsed.ptr - input.data()));
+		return value;
+	};
+	automatic = false;
+	float ratio = -1.f;
+	for (space(); !input.empty(); space())
+	{
+		if (input.size() >= 4 && StringUtilities::ToLower(String(input.substr(0, 4))) == "auto" &&
+			(input.size() == 4 || StringUtilities::IsWhitespace(input[4])))
+		{
+			if (automatic)
+				fail();
+			automatic = true;
+			input.remove_prefix(4);
+			continue;
+		}
+		if (ratio >= 0.f)
+			fail();
+		const float width = number();
+		float height = 1.f;
+		space();
+		if (!input.empty() && input.front() == '/')
+		{
+			input.remove_prefix(1);
+			height = number();
+		}
+		// A zero or infinite term is a degenerate ratio, which behaves as auto.
+		ratio = (width > 0.f && height > 0.f && std::isfinite(width / height)) ? width / height : 0.f;
+	}
+	if (!automatic && ratio < 0.f)
+		fail();
+	return Math::Max(ratio, 0.f);
+}
+
+float LayoutDetails::GetPreferredAspectRatio(Element* element)
+{
+	// Not inherited and initially auto: only an authored value can set a ratio.
+	if (!element->GetLocalProperty(PropertyId::AspectRatio))
+		return 0.f;
+	const Property* property = element->GetProperty(PropertyId::AspectRatio);
+	bool automatic = false;
+	const float ratio = property ? ParseAspectRatio(property->Get<String>(), automatic) : 0.f;
+	if (ratio > 0.f && element->IsReplaced())
+	{
+		Vector2f natural_size;
+		float natural_ratio = -1.f;
+		if (!automatic || !element->GetIntrinsicDimensions(natural_size, natural_ratio) || natural_ratio <= 0.f)
+			throw std::runtime_error("UI aspect-ratio on replaced elements is not represented.");
+		return 0.f;
+	}
+	return ratio;
+}
+
+// The content size the ratio transfers to one axis from the other axis's content size; the ratio relates the boxes
+// box-sizing names.
+static float TransferAspectRatio(float ratio, const Box& box, const ComputedValues& computed, bool to_height, float from_content_size)
+{
+	float edges_from = 0.f, edges_to = 0.f;
+	if (computed.box_sizing() == Style::BoxSizing::BorderBox)
+	{
+		const float horizontal = box.GetSizeAcross(BoxDirection::Horizontal, BoxArea::Border, BoxArea::Padding);
+		const float vertical = box.GetSizeAcross(BoxDirection::Vertical, BoxArea::Border, BoxArea::Padding);
+		edges_from = to_height ? horizontal : vertical;
+		edges_to = to_height ? vertical : horizontal;
+	}
+	const float from = from_content_size + edges_from;
+	return Math::Max(0.f, (to_height ? from / ratio : from * ratio) - edges_to);
+}
+
+// A ratio-derived size is definite for a scroll container or under an authored minimum; otherwise the automatic
+// minimum lets content grow it (CSS Box Sizing 4 §5.2).
+static bool IsDefiniteAspectRatioSize(Element* element, bool height)
+{
+	const ComputedValues& computed = element->GetComputedValues();
+	return LayoutDetails::IsScrollContainer(computed.overflow_x(), computed.overflow_y()) ||
+		element->GetLocalProperty(height ? PropertyId::MinHeight : PropertyId::MinWidth);
+}
+
+// Sizes the auto axis of a box with a preferred aspect ratio from its definite axis (CSS Box Sizing 4 §5.1).
+static void ApplyAspectRatio(Box& box, Vector2f& content_area, Vector2f min_size, Vector2f max_size, Vector2f containing_block,
+	Element* element, BuildBoxMode box_context)
+{
+	const float ratio = LayoutDetails::GetPreferredAspectRatio(element);
+	if (ratio <= 0.f)
+		return;
+	if (box_context == BuildBoxMode::IntrinsicWidth)
+		throw std::runtime_error("UI aspect-ratio on grid items is not represented.");
+	const ComputedValues& computed = element->GetComputedValues();
+	if (content_area.x >= 0.f && content_area.y < 0.f)
+	{
+		if (IsDefiniteAspectRatioSize(element, true))
+			content_area.y = Math::Clamp(TransferAspectRatio(ratio, box, computed, true, content_area.x), min_size.y, max_size.y);
+	}
+	else if (content_area.y >= 0.f && content_area.x < 0.f)
+	{
+		float width = TransferAspectRatio(ratio, box, computed, false, content_area.y);
+		if (!IsDefiniteAspectRatioSize(element, false))
+		{
+			// The automatic minimum is the min-content width: the content formatted at zero inline size.
+			Box measure = box;
+			measure.SetContent({0.f, content_area.y});
+			RootBox root(Math::Max(containing_block, Vector2f(0.f)));
+			const auto layout = FormattingContext::FormatIndependent(&root, element, &measure, FormattingContextType::Block);
+			width = Math::Max(width, layout->GetShrinkToFitWidth());
+		}
+		content_area.x = Math::Clamp(width, min_size.x, max_size.x);
+	}
+}
+
+// The auto block size a preferred aspect ratio transfers from the box's resolved inline size, clamped, or -1.
+// `definite` reports whether it is the used size or a minimum the content can exceed.
+static float AspectRatioHeight(Element* element, const Box& box, float min_height, float max_height, bool& definite)
+{
+	const Vector2f size = box.GetSize();
+	if (size.y >= 0.f || size.x < 0.f)
+		return -1.f;
+	const float ratio = LayoutDetails::GetPreferredAspectRatio(element);
+	if (ratio <= 0.f)
+		return -1.f;
+	definite = IsDefiniteAspectRatioSize(element, true);
+	return Math::Clamp(TransferAspectRatio(ratio, box, element->GetComputedValues(), true, size.x), min_height, max_height);
+}
+
+void LayoutDetails::ApplyAspectRatioHeight(float& min_height, float& max_height, Element* element, const Box& box)
+{
+	bool definite = false;
+	const float height = AspectRatioHeight(element, box, min_height, max_height, definite);
+	if (height < 0.f)
+		return;
+	min_height = height;
+	if (definite)
+		max_height = height;
+}
