diff --git a/Source/Core/Layout/LayoutDetails.cpp b/Source/Core/Layout/LayoutDetails.cpp
index c39dbbf..351b0f8 100644
--- a/Source/Core/Layout/LayoutDetails.cpp
+++ b/Source/Core/Layout/LayoutDetails.cpp
@@ -254,8 +254,14 @@ float LayoutDetails::GetShrinkToFitWidth(Element* element, Vector2f containing_b
 	float shrink_to_fit_width = layout_box->GetShrinkToFitWidth();
 	if (containing_block.x >= 0)
 	{
-		const float available_width =
-			Math::Max(0.f, containing_block.x - box.GetSizeAcross(BoxDirection::Horizontal, BoxArea::Margin, BoxArea::Padding));
+		// CSS 2.1 section 10.3.7: for an absolutely positioned element the 'left' and 'right' values take part in the
+		// available width, so a box with one offset shrinks to fit the space beside that offset.
+		const auto& computed = element->GetComputedValues();
+		float inset_width = 0.f;
+		if (computed.position() == Style::Position::Absolute || computed.position() == Style::Position::Fixed)
+			inset_width = ResolveValue(computed.left(), containing_block.x) + ResolveValue(computed.right(), containing_block.x);
+		const float available_width = Math::Max(0.f,
+			containing_block.x - inset_width - box.GetSizeAcross(BoxDirection::Horizontal, BoxArea::Margin, BoxArea::Padding));
 		shrink_to_fit_width = Math::Min(shrink_to_fit_width, available_width);
 	}
 	return shrink_to_fit_width;
