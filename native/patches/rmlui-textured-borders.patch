 namespace Rml {
+namespace {
+namespace BorderImageDetail {
+enum class LengthUnit { Number, Pixels, DensityPixels, Percent, Auto };
+struct Length { float value = 0; LengthUnit unit = LengthUnit::Number; };
+
+inline bool ReadLength(std::istream& input, Length& result)
+{
+    String token;
+    if (!(input >> token)) return false;
+    if (token == "auto") { result.unit = LengthUnit::Auto; return true; }
+    if (token.size() >= 2 && token.compare(token.size() - 2, 2, "px") == 0) {
+        token.resize(token.size() - 2); result.unit = LengthUnit::Pixels;
+    } else if (token.size() >= 2 && token.compare(token.size() - 2, 2, "dp") == 0) {
+        token.resize(token.size() - 2); result.unit = LengthUnit::DensityPixels;
+    } else if (!token.empty() && token.back() == '%') {
+        token.pop_back(); result.unit = LengthUnit::Percent;
+    }
+    const auto parsed = std::from_chars(token.data(), token.data() + token.size(), result.value);
+    return parsed.ec == std::errc{} && parsed.ptr == token.data() + token.size() &&
+        std::isfinite(result.value) && result.value >= 0;
+}
+
+// Generation expands each box shorthand and packages the source. Runtime
+// keeps percentage slices, border-width multipliers, and auto widths live.
+inline bool Parse(const String& text, String& source, Array<Length, 4>& slices, Array<Length, 4>& widths)
+{
+    if (text.compare(0, 5, "url(\"") != 0) return false;
+    const auto end = text.find("\")", 5);
+    if (end == String::npos) return false;
+    source = text.substr(5, end - 5);
+    std::istringstream input(text.substr(end + 2));
+    for (auto& slice : slices)
+        if (!ReadLength(input, slice) || (slice.unit != LengthUnit::Number && slice.unit != LengthUnit::Percent)) return false;
+    String separator;
+    if (!(input >> separator) || separator != "/") return false;
+    for (auto& width : widths) if (!ReadLength(input, width)) return false;
+    if (!(input >> separator) || separator != "/") return false;
+    for (int i = 0; i < 4; ++i) {
+        Length outset;
+        if (!ReadLength(input, outset) || outset.value != 0 ||
+            (outset.unit != LengthUnit::Number && outset.unit != LengthUnit::Pixels && outset.unit != LengthUnit::DensityPixels)) return false;
+    }
+    if (!(input >> separator) || separator != "stretch") return false;
+    return !(input >> separator);
+}
+} // namespace BorderImageDetail
+
+inline bool GenerateBorderImage(Element* element, const String& text, Mesh& mesh, Texture& texture)
+{
+    using namespace BorderImageDetail;
+    String source;
+    Array<Length, 4> slice_values{}, width_values{};
+    if (!Parse(text, source, slice_values, width_values)) return false;
+    URL document_url;
+    if (const auto* document = element->GetOwnerDocument()) document_url.SetURL(document->GetSourceURL());
+    texture = element->GetRenderManager()->LoadTexture(source, document_url.GetPath());
+    const Vector2f image_size(texture.GetDimensions());
+    if (image_size.x <= 0 || image_size.y <= 0) return false;
+    Array<float, 4> slices{};
+    for (int side = 0; side < 4; ++side) {
+        const float axis = side % 2 == 0 ? image_size.y : image_size.x;
+        slices[side] = std::min(axis, slice_values[side].unit == LengthUnit::Percent ?
+            slice_values[side].value * axis / 100 : slice_values[side].value);
+    }
+    const auto color = Colourb(255).ToPremultiplied(element->GetComputedValues().opacity());
+    for (int box_index = 0; box_index < element->GetNumBoxes(); ++box_index) {
+        const auto render_box = element->GetRenderBox(BoxArea::Border, box_index);
+        const auto size = render_box.GetFillSize();
+        const auto offset = render_box.GetBorderOffset();
+        Vector2f box_offset;
+        const auto& box = element->GetBox(box_index, box_offset);
+        Array<double, 4> widths{};
+        for (int side = 0; side < 4; ++side) {
+            const auto& width = width_values[side];
+            const double value = width.value;
+            switch (width.unit) {
+            case LengthUnit::Number: widths[side] = value * box.GetEdge(BoxArea::Border, BoxEdge(side)); break;
+            case LengthUnit::Pixels: widths[side] = value; break;
+            case LengthUnit::DensityPixels: widths[side] = value * ElementUtilities::GetDensityIndependentPixelRatio(element); break;
+            case LengthUnit::Percent: widths[side] = value * (side % 2 == 0 ? size.y : size.x) / 100; break;
+            case LengthUnit::Auto: widths[side] = double(slices[side]) * ElementUtilities::GetDensityIndependentPixelRatio(element); break;
+            }
+        }
+        // CSS reduces all four used widths by one factor when either pair
+        // overlaps; independent axis clamping would distort the corners.
+        double factor = 1;
+        if (widths[1] + widths[3] > 0) factor = std::min(factor, size.x / (widths[1] + widths[3]));
+        if (widths[0] + widths[2] > 0) factor = std::min(factor, size.y / (widths[0] + widths[2]));
+        for (auto& width : widths) width *= std::max(factor, 0.0);
+        const float x[4] = {0, float(widths[3]), size.x - float(widths[1]), size.x};
+        const float y[4] = {0, float(widths[0]), size.y - float(widths[2]), size.y};
+        const float u[4] = {0, slices[3] / image_size.x, 1 - slices[1] / image_size.x, 1};
+        const float v[4] = {0, slices[0] / image_size.y, 1 - slices[2] / image_size.y, 1};
+        for (int row = 0; row < 3; ++row) for (int column = 0; column < 3; ++column) {
+            // The center is absent unless CSS explicitly requests fill,
+            // which is outside the admitted surface. Overlapping source
+            // slices also remove the corresponding middle edge region.
+            if ((row == 1 && column == 1) || x[column + 1] <= x[column] || y[row + 1] <= y[row] ||
+                u[column + 1] <= u[column] || v[row + 1] <= v[row]) continue;
+            MeshUtilities::GenerateQuad(mesh, offset + Vector2f(x[column], y[row]),
+                {x[column + 1] - x[column], y[row + 1] - y[row]}, color,
+                {u[column], v[row]}, {u[column + 1], v[row + 1]});
+        }
+    }
+    return true;
+}
