{
  "$comment": "Every upstream patch this repository applies. Script-built libraries keep their patches here as <library>/NNNN-slug.patch, NNNN being the application order; vcpkg overlay ports keep theirs in the port directory, whose bytes key each vcpkg install. `variants` selects the builds that apply a patch: `all`, or one of the library's variant tokens (`vcpkg`: the overlay portfile; `trimmed`: tools/build-sdl-min.ps1; Dawn `android`, `metal` (macOS and iOS), `ios`; LabSound `core-only`). Builders read this file, record `<prefix>_SOURCE` and `<prefix>_PATCHES` (name=sha256 in order) in the artifact's record file, and native/patches/patch-identity.cmake refuses an artifact whose record differs. `npm run patches:check` verifies files, headers, order and the portfile lists. Each owned patch file opens with its rationale; `upstream.state` is unsubmitted, open, merged, closed or vcpkg (the port's own patch, copied verbatim).",
  "libraries": {
    "rmlui": {
      "pin": { "file": "upstream/rmlui.json", "field": "commit" },
      "builder": "tools/build-rmlui.ps1",
      "record": { "prefix": "BBLITE_RMLUI", "file": "bblite-rmlui-features.cmake" },
      "variants": []
    },
    "dawn": {
      "pin": { "file": "upstream/tint.json", "field": "commit" },
      "builder": "tools/build-dawn.ps1",
      "record": { "prefix": "BBLITE_DAWN", "file": "bblite-dawn-features.cmake" },
      "variants": ["android", "metal", "ios"]
    },
    "labsound": {
      "pin": { "file": "upstream/labsound.json", "field": "commit" },
      "builder": "tools/build-labsound.ps1",
      "record": { "prefix": "BBLITE_LABSOUND", "file": "bblite-labsound-features.cmake" },
      "variants": ["core-only"]
    },
    "sdl3": {
      "pin": { "file": "native/vcpkg-overlay-ports/sdl3/vcpkg.json", "field": "version" },
      "port": "native/vcpkg-overlay-ports/sdl3",
      "builder": "tools/build-sdl-min.ps1",
      "record": { "prefix": "BBLITE_SDL", "file": "bblite-sdl-features.cmake" },
      "variants": ["vcpkg", "trimmed"]
    },
    "sdl3-image": {
      "pin": { "file": "native/vcpkg-overlay-ports/sdl3-image/vcpkg.json", "field": "version" },
      "port": "native/vcpkg-overlay-ports/sdl3-image",
      "variants": ["vcpkg"]
    },
    "freetype": {
      "pin": { "file": "native/vcpkg-overlay-ports/freetype/vcpkg.json", "field": "version" },
      "port": "native/vcpkg-overlay-ports/freetype",
      "variants": ["vcpkg"]
    },
    "recastnavigation": {
      "pin": { "file": "native/vcpkg-overlay-ports/recastnavigation/vcpkg.json", "field": "version" },
      "port": "native/vcpkg-overlay-ports/recastnavigation",
      "variants": ["vcpkg"]
    }
  },
