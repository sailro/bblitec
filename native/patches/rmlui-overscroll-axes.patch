+	const auto& values = meta->computed_values;
+	const auto scrollable = [](Overflow overflow) { return overflow == Overflow::Auto || overflow == Overflow::Scroll; };
+	const auto container = [](Overflow overflow) { return overflow == Overflow::Hidden || overflow == Overflow::Auto || overflow == Overflow::Scroll; };
+	const bool scrollable_x = scroll_delta.x != 0.f && scrollable(values.overflow_x()) && GetScrollWidth() > GetClientWidth();
+	const bool scrollable_y = scroll_delta.y != 0.f && scrollable(values.overflow_y()) && GetScrollHeight() > GetClientHeight();
+	// RmlUi retains the nearest scrollable target at its boundary. Containment
+	// also stops an axis at a zero-extent scroll container, without blocking the
+	// other axis or turning an ordinary visible box into a scroll container.
+	if (!scrollable_x && container(values.overflow_x()) && values.overscroll_behavior_x() != OverscrollBehavior::Auto) scroll_delta.x = 0.f;
+	if (!scrollable_y && container(values.overflow_y()) && values.overscroll_behavior_y() != OverscrollBehavior::Auto) scroll_delta.y = 0.f;
+	if (allowed_delta) *allowed_delta = scroll_delta;
+	if (scrollable_x || scrollable_y || scroll_delta == Vector2f(0.f)) return this;
+	return parent ? parent->GetClosestScrollableContainer(scroll_delta, allowed_delta) : nullptr;
