The iOS Simulator's Apple2 family does not guarantee texture swizzling.
Retain Dawn's existing non-swizzle depth/stencil view path on Simulator.

--- a/src/dawn/native/metal/UtilsMetal.mm
+++ b/src/dawn/native/metal/UtilsMetal.mm
@@ -1012,3 +1012,8 @@
 bool SupportTextureComponentSwizzle(id<MTLDevice> device) {
+#if DAWN_PLATFORM_IS(IOS) && defined(TARGET_OS_SIMULATOR) && TARGET_OS_SIMULATOR
+    (void)device;
+    return false;
+#else
     return [device supportsFamily:MTLGPUFamilyMac2] || [device supportsFamily:MTLGPUFamilyApple2];
+#endif
 }
