@@ -180,6 +180,15 @@ struct StateImpl : core::ir::transform::ShaderIOBackendState {
     /// @param y another struct member
     /// @returns true if a comes before b
     bool StructMemberComparator(const MemberInfo& x, const MemberInfo& y) {
+        if (config.position_first) {
+            const bool x_position = x.member.attributes.builtin == core::BuiltinValue::kPosition;
+            const bool y_position = y.member.attributes.builtin == core::BuiltinValue::kPosition;
+            if (x_position != y_position) {
+                // The position goes first.
+                return x_position;
+            }
+        }
+
         if (x.member.attributes.color.has_value() && y.member.attributes.color.has_value() &&
             x.member.attributes.color != y.member.attributes.color) {
             // Both have color attributes: smallest goes first.
