+
+static const Element* SelectorOrigin(const CompoundSelector& selector, const Element* element)
+{
+	auto expected = Element::PseudoElement::None;
+	for (const auto& name : selector.pseudo_class_names) {
+		if (name != ":before" && name != ":after") continue;
+		if (expected != Element::PseudoElement::None) return nullptr;
+		expected = name == ":before" ? Element::PseudoElement::Before : Element::PseudoElement::After;
+	}
+	if (element->GetPseudoElement() != expected) return nullptr;
+	return expected == Element::PseudoElement::None ? element : element->GetParentNode();
 }
 
