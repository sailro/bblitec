+
+void AudioListener::updateParams(ContextRenderLock & r)
+{
+    const uint64_t frame = r.context()->currentSampleFrame();
+    if (frame == m_evaluatedFrame)
+        return;
+    m_evaluatedFrame = frame;
+    for (auto & param : {m_positionX, m_positionY, m_positionZ, m_forwardX, m_forwardY, m_forwardZ,
+                         m_upX, m_upY, m_upZ})
+        param->finalValue(r);
+}
