+                m_data.emplace_back(recorded, 0.f);
+                m_data.back().reserve(1024 * 1024);
             }
         }
 
-        // copy the output. @TODO this should be a memcpy
-        std::lock_guard<std::recursive_mutex> lock(m_mutex);
-        for (int c = 0; c < numChannels; ++c)
+        // copy the output, and silence for a channel the input no longer has. @TODO this should be a memcpy
+        for (int c = 0; c < static_cast<int>(m_data.size()); ++c)
         {
             for (int i = 0; i < bufferSize; ++i)
-                m_data[c].push_back(channels[c][i]);
+                m_data[c].push_back(c < numChannels ? channels[c][i] : 0.f);
