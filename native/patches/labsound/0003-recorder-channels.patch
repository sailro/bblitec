-        if (m_data.size() < numChannels)
+        std::lock_guard<std::recursive_mutex> lock(m_mutex);
+        if (m_data.size() < static_cast<size_t>(numChannels))
         {
-            // allocate the recording buffers lazily when the number of input channels is finally known
-            for (int i = 0; i < numChannels; ++i)
+            // allocate the recording buffers lazily when the number of input channels is finally known;
+            // a channel that appears later holds the silence it did not record, so every channel
+            // stays frame-aligned with the first
+            const size_t recorded = m_data.empty() ? 0 : m_data[0].size();
+            while (m_data.size() < static_cast<size_t>(numChannels))
             {
-                m_data.emplace_back(std::vector<float>());
