+struct GridColumnPlacement {
+    size_t begin = 0, end = 1;
+    bool definite = false;
+};
+
+static GridColumnPlacement ParseGridColumn(String value)
+{
+    for (char& character : value) character = char(std::tolower(static_cast<unsigned char>(character)));
+    std::istringstream input(value);
+    input >> std::ws;
+    if (input.peek() == 'a') {
+        String automatic;
+        input >> automatic >> std::ws;
+        if (automatic == "auto" && input.eof()) return {};
+    } else {
+        unsigned begin = 0, end = 0;
+        char slash = 0;
+        if ((input >> begin >> slash >> end) && slash == '/' && begin > 0 && end > begin && end <= 257) {
+            input >> std::ws;
+            if (input.eof()) return {size_t(begin - 1), size_t(end - 1), true};
+        }
+    }
+    throw std::runtime_error("UI grid-column requires auto or ascending positive numeric start/end lines.");
+}
