+	// Object fitting changes the painted image, never its CSS layout box.
+	// Keyword order is shared with the object-fit property specification.
+	enum class ObjectFit { Fill, Contain, Cover, None, ScaleDown };
+	const auto fit = static_cast<ObjectFit>(GetProperty(PropertyId::ObjectFit)->Get<int>());
+	const Vector2f box_size = render_box.GetFillSize();
+	const Vector2f natural_size = (rect_source == RectSource::None ? Vector2f(texture.GetDimensions()) : rect.Size()) * dimensions_scale;
+	Vector2f fitted_size = box_size;
+	if (fit != ObjectFit::Fill && natural_size.x > 0 && natural_size.y > 0)
+	{
+		const float contain_scale = Math::Min(box_size.x / natural_size.x, box_size.y / natural_size.y);
+		float scale = 1.0f;
+		if (fit == ObjectFit::Contain) scale = contain_scale;
+		else if (fit == ObjectFit::Cover) scale = Math::Max(box_size.x / natural_size.x, box_size.y / natural_size.y);
+		else if (fit == ObjectFit::ScaleDown) scale = Math::Min(1.0f, contain_scale);
+		fitted_size = natural_size * scale;
+	}
+	if (box_size.x > 0 && box_size.y > 0 && fitted_size.x > 0 && fitted_size.y > 0)
+	{
+		// Center the image and clip its geometry and UVs to the content box.
+		const Vector2f origin = (box_size - fitted_size) * 0.5f;
+		const Vector2f clipped_start = Math::Max(origin, Vector2f(0));
+		const Vector2f clipped_end = Math::Min(origin + fitted_size, box_size);
+		const Vector2f uv_size = texcoords[1] - texcoords[0];
+		const Vector2f uv_start = texcoords[0] + (clipped_start - origin) / fitted_size * uv_size;
+		const Vector2f uv_end = texcoords[0] + (clipped_end - origin) / fitted_size * uv_size;
+		MeshUtilities::GenerateQuad(mesh, render_box.GetFillOffset() + clipped_start, clipped_end - clipped_start, quad_colour, uv_start, uv_end);
+	}
 
 	if (RenderManager* render_manager = GetRenderManager())
