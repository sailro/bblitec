+Uint64 SDL_BBLiteGetGPUTimestampFrequency(SDL_GPUDevice *device)
+{
+    CHECK_DEVICE_MAGIC(device, 0);
+    return device->GetTimestampFrequency ? device->GetTimestampFrequency(device->driverData) : 0;
+}
+
+SDL_GPUTimestampQueryPool *SDL_BBLiteCreateGPUTimestampQueryPool(SDL_GPUDevice *device, Uint32 count)
+{
+    CHECK_DEVICE_MAGIC(device, NULL);
+    if (!device->CreateTimestampQueryPool) {
+        SDL_SetError("GPU timestamps are unsupported by this driver");
+        return NULL;
+    }
+    if (count == 0 || count > SDL_MAX_UINT32 / sizeof(Uint64)) {
+        SDL_InvalidParamError("count");
+        return NULL;
+    }
+    return device->CreateTimestampQueryPool(device->driverData, count);
+}
+
+void SDL_BBLiteReleaseGPUTimestampQueryPool(SDL_GPUDevice *device, SDL_GPUTimestampQueryPool *pool)
+{
+    CHECK_DEVICE_MAGIC(device, );
+    if (pool && device->ReleaseTimestampQueryPool) {
+        device->ReleaseTimestampQueryPool(device->driverData, pool);
+    }
+}
+
+bool SDL_BBLiteWriteGPUTimestamp(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTimestampQueryPool *pool, Uint32 index)
+{
+    if (!command_buffer || !pool) {
+        return SDL_InvalidParamError(!command_buffer ? "command_buffer" : "pool");
+    }
+    if (COMMAND_BUFFER_DEVICE->debug_mode) {
+        CHECK_COMMAND_BUFFER_RETURN_FALSE
+        CHECK_ANY_PASS_IN_PROGRESS("Timestamp writes must occur outside a pass", false)
+    }
+    if (!COMMAND_BUFFER_DEVICE->WriteTimestamp) {
+        return SDL_SetError("GPU timestamps are unsupported by this driver");
+    }
+    return COMMAND_BUFFER_DEVICE->WriteTimestamp(command_buffer, pool, index);
+}
+
+bool SDL_BBLiteResolveGPUTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTimestampQueryPool *pool, Uint32 count, SDL_GPUTransferBuffer *destination)
+{
+    if (!command_buffer || !pool || !destination) {
+        return SDL_InvalidParamError(!command_buffer ? "command_buffer" : (!pool ? "pool" : "destination"));
+    }
+    if (COMMAND_BUFFER_DEVICE->debug_mode) {
+        CHECK_COMMAND_BUFFER_RETURN_FALSE
+        CHECK_ANY_PASS_IN_PROGRESS("Timestamp resolves must occur outside a pass", false)
+    }
+    if (!COMMAND_BUFFER_DEVICE->ResolveTimestamps) {
+        return SDL_SetError("GPU timestamps are unsupported by this driver");
+    }
+    return COMMAND_BUFFER_DEVICE->ResolveTimestamps(command_buffer, pool, count, destination);
+}
