+/* Babylon Lite timestamp storage. The caller retains this pool through GPU completion. */
+typedef struct D3D12TimestampQueryPool
+{
+    D3D12Renderer *renderer;
+    ID3D12QueryHeap *heap;
+    Uint32 count;
+} D3D12TimestampQueryPool;
+
+static Uint64 D3D12_GetTimestampFrequency(SDL_GPURenderer *driverData)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    UINT64 frequency = 0;
+    if (FAILED(ID3D12CommandQueue_GetTimestampFrequency(renderer->commandQueue, &frequency))) {
+        return 0;
+    }
+    return frequency;
+}
+
+static SDL_GPUTimestampQueryPool *D3D12_CreateTimestampQueryPool(SDL_GPURenderer *driverData, Uint32 count)
+{
+    static const IID queryHeapIID = { 0x0d9658ae, 0xed45, 0x469e, { 0xa6, 0x1d, 0x97, 0x0e, 0xc5, 0x83, 0xca, 0xb4 } };
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12TimestampQueryPool *pool;
+    D3D12_QUERY_HEAP_DESC description;
+    HRESULT res;
+    if (!D3D12_GetTimestampFrequency(driverData)) {
+        SDL_SetError("D3D12 queue does not support timestamps");
+        return NULL;
+    }
+    pool = (D3D12TimestampQueryPool *)SDL_calloc(1, sizeof(*pool));
+    if (!pool) {
+        return NULL;
+    }
+    SDL_zero(description);
+    description.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    description.Count = count;
+    res = ID3D12Device_CreateQueryHeap(renderer->device, &description, D3D_GUID(queryHeapIID), (void **)&pool->heap);
+    if (FAILED(res)) {
+        SDL_free(pool);
+        CHECK_D3D12_ERROR_AND_RETURN("Could not create timestamp query heap", NULL);
+    }
+    pool->renderer = renderer;
+    pool->count = count;
+    return (SDL_GPUTimestampQueryPool *)pool;
+}
+
+static void D3D12_ReleaseTimestampQueryPool(SDL_GPURenderer *driverData, SDL_GPUTimestampQueryPool *queryPool)
+{
+    D3D12TimestampQueryPool *pool = (D3D12TimestampQueryPool *)queryPool;
+    if (pool->renderer != (D3D12Renderer *)driverData) {
+        SDL_SetError("Timestamp query pool belongs to another GPU device");
+        return;
+    }
+    ID3D12QueryHeap_Release(pool->heap);
+    SDL_free(pool);
+}
+
+static bool D3D12_WriteTimestamp(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTimestampQueryPool *queryPool, Uint32 index)
+{
+    D3D12CommandBuffer *command = (D3D12CommandBuffer *)command_buffer;
+    D3D12TimestampQueryPool *pool = (D3D12TimestampQueryPool *)queryPool;
+    if (command->renderer != pool->renderer || index >= pool->count) {
+        return SDL_SetError("Timestamp query index or GPU device is invalid");
+    }
+    ID3D12GraphicsCommandList_EndQuery(command->graphicsCommandList, pool->heap, D3D12_QUERY_TYPE_TIMESTAMP, index);
+    return true;
+}
+
+static bool D3D12_ResolveTimestamps(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTimestampQueryPool *queryPool, Uint32 count, SDL_GPUTransferBuffer *destination)
+{
+    D3D12CommandBuffer *command = (D3D12CommandBuffer *)command_buffer;
+    D3D12TimestampQueryPool *pool = (D3D12TimestampQueryPool *)queryPool;
+    D3D12BufferContainer *buffer = (D3D12BufferContainer *)destination;
+    if (command->renderer != pool->renderer || count == 0 || count > pool->count ||
+        buffer->type != D3D12_BUFFER_TYPE_DOWNLOAD || (Uint64)count * sizeof(Uint64) > buffer->size) {
+        return SDL_SetError("Timestamp resolve range or destination is invalid");
+    }
+    ID3D12GraphicsCommandList_ResolveQueryData(command->graphicsCommandList, pool->heap, D3D12_QUERY_TYPE_TIMESTAMP, 0, count, buffer->activeBuffer->handle, 0);
+    D3D12_INTERNAL_TrackBuffer(command, buffer->activeBuffer);
+    return true;
+}
