{
  "scene": "antigravity-racer",
  "notes": "Split-screen presents distinct canvas views, survives returning through the menu, and can transition to the track editor on both backends.",
  "capture": false,
  "phases": [
    { "id": "split", "frame": 600, "tape": ["-*240", "UiKey@Down", "-*10", "UiKey@Return"] },
    { "id": "split-reentered", "frame": 900, "tape": ["-*240", "UiKey@Down", "-*10", "UiKey@Return", "-*180", "UiKey@Escape", "-*10", "UiKey@Down", "-*10", "UiKey@Down", "-*10", "UiKey@Return", "-*180", "UiKey@Down", "-*10", "UiKey@Return"] },
    { "id": "editor-after-split", "frame": 900, "env": { "BBLITE_CAPTURE_UI": "1" }, "tape": ["-*240", "UiKey@Down", "-*10", "UiKey@Return", "-*180", "UiKey@Escape", "-*10", "UiKey@Down", "-*10", "UiKey@Down", "-*10", "UiKey@Return", "-*180", "UiKey@Down", "-*10", "UiKey@Down", "-*10", "UiKey@Down", "-*10", "UiKey@Down", "-*10", "UiKey@Return"] }
  ],
  "expect": [
    { "kind": "viewport", "phase": "*", "equals": [1280, 720] },
    { "kind": "image-mad", "phase": "editor-after-split", "vs": "split", "min": 5 },
    { "kind": "plugin", "module": "checks/plugins/racer-split.mjs" }
  ]
}
