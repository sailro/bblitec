  "capture": false,
  "timeoutMs": 30000,
  "phases": [
    { "id": "press", "frame": 40, "tape": ["-*30", "+UiMouseLeft@500:378"] },
    { "id": "seven", "frame": 40, "tape": ["-*30", "+UiMouseLeft@500:378", "-UiMouseLeft@500:378"] },
    { "id": "seven-times", "frame": 40, "tape": ["-*30", "+UiMouseLeft@500:378", "-UiMouseLeft@500:378", "-*3", "+UiMouseLeft@683:325", "-UiMouseLeft@683:325"] }
