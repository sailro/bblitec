  "expect": [
    { "kind": "log-match", "phase": "*", "pattern": "flow-graph attach asset=\\S+ runtimes=1\\b" },
    {
      "kind": "plugin",
      "module": "checks/plugins/calculator-digits.mjs",
      "options": {
        "layout": { "tens": { "x": 692, "y": 228, "width": 40, "height": 46 }, "ones": { "x": 732, "y": 228, "width": 42, "height": 46 } },
        "dispatches": { "press": [], "seven": ["Button 7"], "seven-times": ["Button 7", "Button multiply"] }
      }
    }
  ]
}
