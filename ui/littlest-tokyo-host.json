        "aria-pressed": "true",
        "style": "position:fixed;left:12px;bottom:10px;z-index:10001;font:400 12px system-ui,sans-serif;line-height:1;color:#e9e2df;background:rgba(0,0,0,0.45);padding:8px 12px;border-radius:6px;border:1px solid rgba(255,255,255,0.12);cursor:pointer;backdrop-filter:blur(3px);transition:background 0.2s ease;"
      }
