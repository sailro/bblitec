    {
      "tag": "div",
      "attributes": {
        "class": "credit",
        "style": "position:fixed;right:12px;bottom:10px;z-index:10001;display:flex;font:400 11.52px system-ui,sans-serif;line-height:1.3;color:#e9e2df;background:rgba(0,0,0,0.45);padding:5px 9px;border-radius:6px;backdrop-filter:blur(3px);"
      },
      "children": [
        { "tag": "span", "text": "“Littlest Tokyo”", "attributes": { "style": "font-weight:600;white-space:pre;" } },
        { "tag": "span", "text": " by Glen Fox · CC-BY 4.0", "attributes": { "style": "white-space:pre;" } }
      ]
    }
