{
  "styleRules": [
    {
      "kind": "sequence",
      "primary": "html",
      "style": "margin: 0; width: 100%; height: 100%; overflow: hidden; background: #3d6d9e; color: #eef8ff; font-family: system-ui, sans-serif;"
    },
    {
      "kind": "sequence",
      "primary": "body",
      "style": "margin: 0; width: 100%; height: 100%; overflow: hidden; background: #3d6d9e; color: #eef8ff; font-family: system-ui, sans-serif;"
    },
    {
      "kind": "sequence",
      "primary": "canvas",
      "style": "width: 100%; height: 100%; display: block; touch-action: none;"
    },
    {
      "kind": "sequence",
      "primary": ".badge",
      "style": "position: fixed; left: 18px; top: 18px; padding: 10px 14px; border: 1px solid rgba(220, 242, 255, 0.4); border-radius: 10px; background: rgba(8, 28, 48, 0.58); backdrop-filter: blur(9px); pointer-events: none;"
    },
    {
      "kind": "sequence",
      "primary": ".badge strong",
      "style": "display: block; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase;"
    },
    {
      "kind": "sequence",
      "primary": ".badge span",
      "style": "display: block; margin-top: 3px; font-size: 12px; color: #b9d7e8;"
    },
    {
      "kind": "sequence",
      "primary": ".badge a",
      "style": "pointer-events: auto;"
    },
    {
      "kind": "sequence",
      "primary": ".controls",
      "style": "position: fixed; top: 18px; right: 18px; z-index: 4; width: min(310px, calc(100vw - 36px)); max-height: calc(100vh - 36px); overflow-y: auto; padding: 14px; border: 1px solid rgba(220, 242, 255, 0.32); border-radius: 12px; background: rgba(8, 28, 48, 0.62); backdrop-filter: blur(10px);"
    },
    {
      "kind": "sequence",
      "primary": ".controls label",
      "style": "display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin: 8px 0; font-size: 12px;"
    },
    {
      "kind": "sequence",
      "primary": ".controls .row",
      "style": "display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin: 8px 0; font-size: 12px;"
    },
    {
      "kind": "sequence",
      "primary": ".controls input[type=\"range\"]",
      "style": "grid-column: 1 / 3; width: 100%;"
    },
    {
      "kind": "sequence",
      "primary": ".controls details",
      "style": "margin-top: 8px; border-top: 1px solid rgba(220, 242, 255, 0.15); padding-top: 7px;"
    },
    {
      "kind": "sequence",
      "primary": ".controls summary",
      "style": "cursor: pointer; font-size: 13px; font-weight: 650; color: #d9f1ff;"
    },
    {
      "kind": "sequence",
      "primary": ".controls .check-row",
      "style": "grid-template-columns: 1fr auto;"
    },
    {
      "kind": "sequence",
      "primary": ".controls select",
      "style": "border: 1px solid rgba(220, 242, 255, 0.3); border-radius: 7px; padding: 6px 9px; color: #eef8ff; background: rgba(20, 52, 78, 0.9);"
    },
    {
      "kind": "sequence",
      "primary": ".controls button",
      "style": "border: 1px solid rgba(220, 242, 255, 0.3); border-radius: 7px; padding: 6px 9px; color: #eef8ff; background: rgba(20, 52, 78, 0.9);"
    },
    {
      "kind": "sequence",
      "primary": ".controls button",
      "style": "cursor: pointer;"
    },
    {
      "kind": "sequence",
      "primary": ".controls output",
      "style": "min-width: 3em; text-align: right; color: #bdeeff;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing",
      "style": "position: fixed; left: 18px; top: 109px; z-index: 4; min-width: 220px; padding: 12px 14px; border: 1px solid rgba(220, 242, 255, 0.32); border-radius: 10px; background: rgba(8, 28, 48, 0.62); backdrop-filter: blur(10px); font-size: 12px;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing h2",
      "style": "margin: 0 0 8px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing dl",
      "style": "display: grid; grid-template-columns: 1fr auto; gap: 5px 14px; margin: 0;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing dt",
      "style": "margin: 0;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing dd",
      "style": "margin: 0;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing dd",
      "style": "color: #bdeeff; font-variant-numeric: tabular-nums;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing .status",
      "style": "margin-top: 8px; color: #93b9ce; font-size: 11px;"
    },
    {
      "kind": "sequence",
      "primary": ".gpu-timing .timing-child",
      "style": "padding-left: 14px; color: #c8ddea;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-overlay",
      "style": "position: fixed; inset: 0; z-index: 10; display: grid; place-items: center; background: radial-gradient(circle at 50% 35%, #315e87, #071522 75%); transition: opacity 0.35s ease;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-overlay.is-hidden",
      "style": "opacity: 0; pointer-events: none;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-box",
      "style": "display: grid; gap: 12px; justify-items: center;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-spinner",
      "style": "width: 48px; height: 48px; border: 4px solid rgba(210, 239, 255, 0.2); border-top-color: #c6efff; border-radius: 50%; animation: spin 0.9s linear infinite;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-bar",
      "style": "width: min(280px, 65vw); height: 4px; overflow: hidden; border-radius: 99px; background: rgba(255, 255, 255, 0.16);"
    },
    {
      "kind": "sequence",
      "primary": ".loading-bar-fill",
      "style": "width: 15%; height: 100%; border-radius: inherit; background: #bdeeff;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-size",
      "style": "min-height: 1em; font-size: 12px; color: #b9d7e8;"
    }
  ],
  "elements": [
    {
      "tag": "style",
      "text": "@keyframes spin { to { transform: rotate(360deg); } }"
    },
    {
      "tag": "canvas",
      "attributes": {
        "id": "renderCanvas"
      }
    },
    {
      "tag": "div",
      "attributes": {
        "class": "badge"
      },
      "children": [
        {
          "tag": "strong",
          "text": "FFT Ocean"
        },
        {
          "tag": "span",
          "text": "Three cascades · clipmap · buoyancy · ",
          "children": [
            {
              "tag": "a",
              "attributes": {
                "id": "referenceLink",
                "href": "./demo-ocean-reference.html",
                "style": "color: #bdeeff"
              },
              "text": "reference"
            }
          ]
        },
        {
          "tag": "span",
          "text": "F8: toggle UI"
        }
      ]
    },
    {
      "tag": "aside",
      "attributes": {
        "id": "ocean-gpu-timing",
        "class": "gpu-timing"
      },
      "children": [
        {
          "tag": "h2",
          "text": "GPU timing"
        },
        {
          "tag": "dl",
          "children": [
            {
              "tag": "dt",
              "text": "FPS"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "fps"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "text": "Compute shaders"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "compute"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "attributes": {
                "class": "timing-child"
              },
              "text": "Spectrum evolution"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "spectrum"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "attributes": {
                "class": "timing-child"
              },
              "text": "Inverse FFT"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "fft"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "attributes": {
                "class": "timing-child"
              },
              "text": "Merge + buoy probe"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "merge"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "text": "Output mipmaps"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "mipmaps"
              },
              "text": "—"
            },
            {
              "tag": "dt",
              "text": "All GPU tasks"
            },
            {
              "tag": "dd",
              "attributes": {
                "data-timing": "total"
              },
              "text": "—"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {
            "class": "status",
            "data-timing": "status"
          },
          "text": "Enabling timestamp queries…"
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {
        "id": "ocean-controls",
        "class": "controls"
      }
    },
    {
      "tag": "div",
      "attributes": {
        "id": "loading",
        "class": "loading-overlay"
      },
      "children": [
        {
          "tag": "div",
          "attributes": {
            "class": "loading-box"
          },
          "children": [
            {
              "tag": "div",
              "attributes": {
                "class": "loading-spinner"
              }
            },
            {
              "tag": "div",
              "text": "Preparing spectral ocean…"
            },
            {
              "tag": "div",
              "attributes": {
                "class": "loading-bar"
              },
              "children": [
                {
                  "tag": "div",
                  "attributes": {
                    "class": "loading-bar-fill"
                  }
                }
              ]
            },
            {
              "tag": "div",
              "attributes": {
                "class": "loading-size"
              }
            }
          ]
        }
      ]
    }
  ]
}
