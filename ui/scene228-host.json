{
  "classStyles": [
    {
      "className": "pane",
      "style": "position:relative;min-width:0;width:50%;height:100%;overflow:hidden;"
    },
    {
      "className": "label",
      "style": "position:absolute;top:8px;left:10px;font:12px sans-serif;color:#ddd;padding:2px 6px;background:rgba(0,0,0,0.55);border-radius:3px;pointer-events:none;"
    }
  ],
  "elements": [
    {
      "tag": "div",
      "attributes": {
        "style": "position:fixed;inset:0;display:flex;gap:4px;"
      },
      "children": [
        {
          "tag": "div",
          "attributes": {
            "class": "pane"
          },
          "children": [
            {
              "tag": "canvas",
              "attributes": {
                "id": "renderCanvas",
                "style": "width:100%;height:100%;display:block;pointer-events:none;"
              }
            },
            {
              "tag": "div",
              "attributes": {
                "class": "label"
              },
              "text": "Canvas A — spheres"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {
            "class": "pane"
          },
          "children": [
            {
              "tag": "canvas",
              "attributes": {
                "id": "canvasB",
                "style": "width:100%;height:100%;display:block;pointer-events:none;"
              }
            },
            {
              "tag": "div",
              "attributes": {
                "class": "label"
              },
              "text": "Canvas B — torus knot"
            }
          ]
        }
      ]
    },
    {
      "tag": "div",
      "attributes": {
        "style": "position:fixed;left:calc(50% - 2px);top:0;width:4px;height:100%;background:#222;pointer-events:none;"
      }
    }
  ]
}
