{
  "styleRules": [
    {
      "kind": "class-descendant-tag",
      "primary": "controls",
      "tag": "button",
      "style": "border:1px solid #7685a8;border-radius:999px;padding:9px 14px;color:#f5f7ff;background:rgba(26,34,53,0.88);cursor:pointer;backdrop-filter:blur(8px);"
    },
    {
      "kind": "tag-class",
      "tag": "button",
      "primary": "disabled",
      "style": "color:#929bb2;border-color:#4b5265;background:rgba(20,24,35,0.82);"
    }
  ],
  "elements": [
    {
      "tag": "div",
      "attributes": {
        "class": "controls",
        "style": "position:fixed;left:18px;top:18px;display:flex;gap:8px;max-width:calc(100vw - 36px);z-index:4;"
      },
      "children": [
        {
          "tag": "button",
          "attributes": {
            "id": "toggleContact"
          }
        },
        {
          "tag": "button",
          "attributes": {
            "id": "toggleGi"
          }
        },
        {
          "tag": "button",
          "attributes": {
            "id": "toggleOrbit"
          }
        }
      ]
    }
  ]
}
