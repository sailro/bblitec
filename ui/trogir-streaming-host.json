{
  "styleRules": [
    {
      "kind": "sequence",
      "primary": ":root",
      "style": "color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif;"
    },
    {
      "kind": "sequence",
      "primary": "html",
      "style": "margin: 0; width: 100%; height: 100%; overflow: hidden; background: #080b0e; color: #f4f6f8;"
    },
    {
      "kind": "sequence",
      "primary": "body",
      "style": "margin: 0; width: 100%; height: 100%; overflow: hidden; background: #080b0e; color: #f4f6f8;"
    },
    {
      "kind": "sequence",
      "primary": "canvas",
      "style": "width: 100%; height: 100%; display: block; touch-action: none;"
    },
    {
      "kind": "sequence",
      "primary": ".glass",
      "style": "background: rgba(8, 12, 16, 0.76); border: 1px solid rgba(255, 255, 255, 0.16); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); backdrop-filter: blur(10px);"
    },
    {
      "kind": "sequence",
      "primary": "#loading",
      "style": "position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; background: radial-gradient(circle at 50% 42%, #17212a, #080b0e 65%); transition: opacity 0.35s ease;"
    },
    {
      "kind": "sequence",
      "primary": "#loading.hidden",
      "style": "opacity: 0; pointer-events: none;"
    },
    {
      "kind": "sequence",
      "primary": ".loading-card",
      "style": "max-width: 580px; margin: 20px; padding: 24px 28px; border-radius: 14px; text-align: center;"
    },
    {
      "kind": "sequence",
      "primary": ".spinner",
      "style": "width: 44px; height: 44px; margin: 0 auto 16px; border: 4px solid #31424f; border-top-color: #58c6ff; border-radius: 50%; animation: spin 0.8s linear infinite;"
    },
    {
      "kind": "sequence",
      "primary": "#loading.error .spinner",
      "style": "display: none;"
    },
    {
      "kind": "sequence",
      "primary": "#loading.error .loading-card",
      "style": "border-color: rgba(255, 112, 112, 0.6);"
    },
    {
      "kind": "sequence",
      "primary": "#loadingTitle",
      "style": "margin: 0 0 7px; font-size: 1.1rem;"
    },
    {
      "kind": "sequence",
      "primary": "#loadingDetail",
      "style": "margin: 0; color: #b9c7d1; line-height: 1.5; white-space: pre-wrap;"
    },
    {
      "kind": "sequence",
      "primary": "#hud",
      "style": "position: fixed; top: 12px; left: 12px; z-index: 10; width: min(310px, calc(100vw - 48px)); max-height: calc(100vh - 52px); padding: 13px 15px; overflow-y: auto; border-radius: 10px; font-size: 12px;"
    },
    {
      "kind": "sequence",
      "primary": "#hud h1",
      "style": "margin: 0 0 9px; font-size: 14px; font-weight: 650;"
    },
    {
      "kind": "sequence",
      "primary": ".stats",
      "style": "display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; margin-bottom: 12px; color: #bdc9d1;"
    },
    {
      "kind": "sequence",
      "primary": ".stats output",
      "style": "color: #fff; font-variant-numeric: tabular-nums;"
    },
    {
      "kind": "sequence",
      "primary": ".control",
      "style": "display: grid; grid-template-columns: 85px 1fr 58px; align-items: center; gap: 8px; margin-top: 8px;"
    },
    {
      "kind": "sequence",
      "primary": ".control input",
      "style": "width: 100%; accent-color: #58c6ff;"
    },
    {
      "kind": "sequence",
      "primary": ".control output",
      "style": "text-align: right; font-variant-numeric: tabular-nums;"
    },
    {
      "kind": "sequence",
      "primary": ".control select",
      "style": "grid-column: 2 / 4; min-width: 0;"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose",
      "style": "margin-top: 10px; padding-top: 9px; border-top: 1px solid rgba(255, 255, 255, 0.13);"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose summary",
      "style": "color: #d9e5eb; cursor: pointer; user-select: none;"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose-grid",
      "style": "display: grid; grid-template-columns: 1fr auto; gap: 3px 14px; margin-top: 8px; color: #9fb0bb;"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose-grid output",
      "style": "color: #fff; font-variant-numeric: tabular-nums;"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose-convention",
      "style": "margin: 7px 0 0; color: #788c99; line-height: 1.35;"
    },
    {
      "kind": "sequence",
      "primary": ".camera-pose-status",
      "style": "margin: 7px 0 0; color: #ffb3b3;"
    },
    {
      "kind": "sequence",
      "primary": ".hint",
      "style": "margin-top: 10px; color: #8fa1ae;"
    },
    {
      "kind": "sequence",
      "primary": ".credit",
      "style": "position: fixed; z-index: 11; right: 12px; bottom: 12px; max-width: min(520px, calc(100vw - 48px)); padding: 7px 10px; border-radius: 7px; color: #eaf1f5; font-size: 11px; line-height: 1.4; text-decoration: none;"
    },
    {
      "kind": "sequence",
      "primary": ".credit:hover",
      "style": "background: rgba(8, 12, 16, 0.94);"
    },
    {
      "kind": "sequence",
      "primary": "#hud",
      "maxWidth": 620,
      "style": "top: 8px; left: 8px;"
    },
    {
      "kind": "sequence",
      "primary": ".credit",
      "maxWidth": 620,
      "style": "right: 8px; bottom: 8px;"
    },
    {
      "kind": "sequence",
      "primary": ".spinner",
      "reducedMotion": true,
      "style": "animation: none;"
    }
  ],
  "elements": [
    {
      "tag": "style",
      "text": "@keyframes spin { to { transform: rotate(360deg); } }"
    },
    {
      "tag": "canvas",
      "attributes": {
        "id": "renderCanvas"
      }
    },
    {
      "tag": "div",
      "attributes": {
        "id": "loading",
        "role": "status",
        "aria-live": "polite"
      },
      "children": [
        {
          "tag": "div",
          "attributes": {
            "class": "loading-card glass"
          },
          "children": [
            {
              "tag": "div",
              "attributes": {
                "class": "spinner",
                "aria-hidden": "true"
              }
            },
            {
              "tag": "h1",
              "attributes": {
                "id": "loadingTitle"
              },
              "text": "Preparing coarse Trogir view…"
            },
            {
              "tag": "p",
              "attributes": {
                "id": "loadingDetail"
              },
              "text": "Streaming the public Trogir hierarchy and its broadest shared representation. Fine detail follows after this view is drawable."
            },
            {
              "tag": "a",
              "attributes": {
                "id": "lowerQuality",
                "hidden": ""
              },
              "text": "Retry with lower memory"
            }
          ]
        }
      ]
    },
    {
      "tag": "aside",
      "attributes": {
        "id": "hud",
        "class": "glass",
        "aria-label": "Streaming controls and statistics"
      },
      "children": [
        {
          "tag": "h1",
          "text": "Trogir · Gaussian splat streaming"
        },
        {
          "tag": "div",
          "attributes": {
            "class": "stats"
          },
          "children": [
            {
              "tag": "span",
              "text": "Phase"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "phase"
              },
              "text": "bootstrap"
            },
            {
              "tag": "span",
              "text": "First coarse frame"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "firstFrame"
              },
              "text": "—"
            },
            {
              "tag": "span",
              "text": "Selected splats"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "selectedSplats"
              },
              "text": "0"
            },
            {
              "tag": "span",
              "text": "Visible / covered leaves"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "leaves"
              },
              "text": "0 / 0"
            },
            {
              "tag": "span",
              "text": "Resident / allocated GPU"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "gpuBytes"
              },
              "text": "0 / 0 MB"
            },
            {
              "tag": "span",
              "text": "Resident files / requests"
            },
            {
              "tag": "output",
              "attributes": {
                "id": "requests"
              },
              "text": "0 / 0"
            }
          ]
        },
        {
          "tag": "label",
          "attributes": {
            "class": "control",
            "for": "quality"
          },
          "children": [
            {
              "tag": "span",
              "text": "Quality"
            },
            {
              "tag": "select",
              "attributes": {
                "id": "quality",
                "aria-describedby": "qualityHint"
              },
              "children": [
                {
                  "tag": "option",
                  "attributes": {
                    "value": "low"
                  },
                  "text": "Lower memory · 1M splats"
                },
                {
                  "tag": "option",
                  "attributes": {
                    "value": "high"
                  },
                  "text": "High detail · 4M splats"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {
            "id": "qualityHint",
            "class": "hint"
          },
          "text": "Changing quality reloads the scene."
        },
        {
          "tag": "label",
          "attributes": {
            "class": "control",
            "for": "screenError"
          },
          "children": [
            {
              "tag": "span",
              "text": "Detail error"
            },
            {
              "tag": "input",
              "attributes": {
                "id": "screenError",
                "type": "range",
                "min": "0.5",
                "max": "8",
                "value": "2",
                "step": "0.25"
              }
            },
            {
              "tag": "output",
              "attributes": {
                "id": "screenErrorValue"
              },
              "text": "2.00 px"
            }
          ]
        },
        {
          "tag": "label",
          "attributes": {
            "class": "control",
            "for": "splatBudget"
          },
          "children": [
            {
              "tag": "span",
              "text": "Splat budget"
            },
            {
              "tag": "input",
              "attributes": {
                "id": "splatBudget",
                "type": "range",
                "min": "10000",
                "max": "1000000",
                "value": "1000000",
                "step": "10000"
              }
            },
            {
              "tag": "output",
              "attributes": {
                "id": "splatBudgetValue"
              },
              "text": "1000k"
            }
          ]
        },
        {
          "tag": "div",
          "attributes": {
            "class": "hint"
          },
          "text": "Drag to look · WASD or arrows to move · Space / Shift to rise or lower"
        },
        {
          "tag": "div",
          "attributes": {
            "id": "navigationStatus",
            "class": "hint",
            "role": "status"
          },
          "text": "Loading collision data for navigation…"
        },
        {
          "tag": "details",
          "attributes": {
            "id": "cameraPose",
            "class": "camera-pose"
          },
          "children": [
            {
              "tag": "summary",
              "text": "Camera pose"
            },
            {
              "tag": "div",
              "attributes": {
                "class": "camera-pose-grid"
              },
              "children": [
                {
                  "tag": "span",
                  "text": "Position X"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraX"
                  },
                  "text": "0.00"
                },
                {
                  "tag": "span",
                  "text": "Position Y"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraY"
                  },
                  "text": "0.00"
                },
                {
                  "tag": "span",
                  "text": "Position Z"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraZ"
                  },
                  "text": "0.00"
                },
                {
                  "tag": "span",
                  "text": "Yaw"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraYaw"
                  },
                  "text": "0.00°"
                },
                {
                  "tag": "span",
                  "text": "Pitch"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraPitch"
                  },
                  "text": "0.00°"
                },
                {
                  "tag": "span",
                  "text": "Roll"
                },
                {
                  "tag": "output",
                  "attributes": {
                    "id": "cameraRoll"
                  },
                  "text": "0.00°"
                }
              ]
            },
            {
              "tag": "p",
              "attributes": {
                "id": "cameraPoseStatus",
                "class": "camera-pose-status",
                "role": "status",
                "hidden": ""
              },
              "text": "Camera pose unavailable"
            },
            {
              "tag": "p",
              "attributes": {
                "class": "camera-pose-convention"
              },
              "text": "World position · degrees · yaw about world Y · pitch positive looking up"
            }
          ]
        }
      ]
    },
    {
      "tag": "a",
      "attributes": {
        "class": "credit glass",
        "href": "https://superspl.at/scene/14bac5b2",
        "target": "_blank",
        "rel": "noopener noreferrer"
      },
      "children": [
        {
          "tag": "b",
          "text": "“Get lost in the alleys of historical Trogir, Croatia”"
        },
        {
          "text": " by Paolo Tosolini · source · CC BY 4.0"
        }
      ]
    }
  ]
}
